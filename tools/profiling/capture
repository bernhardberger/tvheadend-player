#!/usr/bin/env bash
# One bounded batch on an already verified, foreground, warmed app. No install or launch.
# Invoke inside the existing ADB tunnel for LXC119. See docs/profiling.md for identity gates.
set -euo pipefail
umask 077
if (( $# < 6 )); then
    printf 'usage: bash tools/profiling/capture MODE DEVICE PACKAGE NEW_OUTPUT_DIR RUNS KEYCODE...\n' >&2
    exit 2
fi
mode=$1 device=$2 package=$3 output=$4 runs=$5
shift 5
key_delay=${TVHPLAYER_PROFILE_KEY_DELAY_SECONDS:-0.4}
# Zero requests back-to-back guarded dispatch, not a claimed fixed input cadence.
case "$key_delay" in 0|0.1|0.4) ;; *) exit 2 ;; esac
input_transport=${TVHPLAYER_PROFILE_INPUT_TRANSPORT:-java}
allow_back=${TVHPLAYER_PROFILE_ALLOW_BACK:-false}
duration=${TVHPLAYER_PROFILE_DURATION_SECONDS:-8}
case "$duration" in 8|30|60) ;; *) exit 2 ;; esac
video=${TVHPLAYER_PROFILE_VIDEO:-false}
case "$video" in true|false) ;; *) exit 2 ;; esac
case "$allow_back" in true|false) ;; *) exit 2 ;; esac
case "$input_transport" in
    java) input_command=input ;;
    cmd) input_command='cmd input' ;;
    *) exit 2 ;;
esac
case "$mode" in atrace|causal|frames|cpu|native-allocations) ;; *) exit 2 ;; esac
[[ "$video" == false || "$mode" == causal ]] || exit 2
case "$package" in at.bernhardberger.tvhplayer|at.bernhardberger.tvhplayer.profile) ;; *) exit 2 ;; esac
[[ -n "$device" && "$runs" =~ ^[1-3]$ && $# -le 80 ]] || exit 2
[[ $# -le 12 || "$duration" != 8 ]] || exit 2
case "$key_delay" in 0) delay_ms=0 ;; 0.1) delay_ms=100 ;; 0.4) delay_ms=400 ;; esac
# Necessary sleep/start/tail budget, not a guarantee about guard or input latency.
(( duration * 1000 >= 4000 + $# * delay_ms )) || exit 2
back_count=0
for key in "$@"; do
    case "$key" in
        4) [[ "$allow_back" == true ]] || exit 2; back_count=$((back_count + 1)); [[ "$back_count" == 1 ]] || exit 2 ;;
        19|20|21|22|166|167) ;;
        *) exit 2 ;;
    esac
done
[[ ! -e "$output" && -d "$(dirname "$output")" ]]
mkdir -m 700 "$output"
root=$(git rev-parse --show-toplevel)
pid=$(adb -s "$device" shell pidof "$package" | tr -d '\r')
[[ "$pid" =~ ^[0-9]+$ ]]
cleanup() {
    status=$?
    if (( status != 0 )); then
        printf 'Capture failed with exit %s; no successful measurement is implied.\n' "$status" >&2
    fi
    printf 'Stopping only %s after capture; the underlying app may become visible.\n' "$package" >&2
    if ! adb -s "$device" shell "am force-stop $package; ! pidof $package" >/dev/null; then
        printf 'Could not confirm package cleanup\n' >&2
        status=1
    fi
    exit "$status"
}
trap cleanup EXIT
{
    date -u '+utc=%FT%TZ'
    printf 'mode=%s\npackage=%s\npid=%s\nruns=%s\nkeycodes=%s\n' "$mode" "$package" "$pid" "$runs" "$*"
    printf 'key_delay_seconds=%s\n' "$key_delay"
    printf 'input_transport=%s\n' "$input_transport"
    printf 'allow_single_back=%s\n' "$allow_back"
    printf 'duration_seconds=%s\n' "$duration"
    printf 'video_monotonic_overlay=%s\n' "$video"
    installed_path=$(adb -s "$device" shell pm path "$package" | tr -d '\r')
    [[ "$installed_path" == package:* && "$installed_path" != *$'\n'* ]]
    read -r apk_sha remainder <<< "$(adb -s "$device" shell sha256sum "${installed_path#package:}")"
    [[ "$apk_sha" =~ ^[[:xdigit:]]{64}$ ]]
    printf 'installed_apk_sha256=%s\n' "$apk_sha"
    git rev-parse HEAD
    git diff --binary HEAD -- app/src app/build.gradle.kts app/proguard-rules.pro tools/profiling | sha256sum
    git status --porcelain --untracked-files=all -- app/src app/build.gradle.kts app/proguard-rules.pro tools/profiling
    uptime
    adb -s "$device" shell 'for p in ro.product.manufacturer ro.product.model ro.product.device ro.product.name; do getprop "$p"; done'
} > "$output/capture-metadata.txt"
remote="/data/local/tmp/p44-${pid}"
config="/data/misc/perfetto-configs/p44-${pid}.pbtxt"
trace_path="$remote.trace"
video_path="$remote.mp4"
if [[ "$mode" != atrace ]]; then
    trace_path="/data/misc/perfetto-traces/p44-${pid}.trace"
    python3 -c 'import pathlib,sys
text=pathlib.Path(sys.argv[1]).read_text()
assert text.count("duration_ms: 8000") == 1
text=text.replace("duration_ms: 8000", "duration_ms: " + str(int(sys.argv[2])*1000))
if int(sys.argv[2]) > 8:
    text += "\nwrite_into_file: true\nfile_write_period_ms: 1000\nflush_period_ms: 1000\n"
print(text, end="")' \
        "$root/tools/profiling/$mode.pbtxt" "$duration" > "$output/recording.pbtxt"
    adb -s "$device" push "$output/recording.pbtxt" "$config" >/dev/null
fi
# Guard every injection on-device. Its WindowManager work is recording overhead,
# not Player work; keep guarded batches distinct from older unguarded evidence.
guard="guard() { [ \"\$(pidof $package)\" = '$pid' ] && dumpsys window | grep 'mCurrentFocus=' | grep -Fq '$package/'; };"
events='sleep 1;'
for key in "$@"; do events+=" guard || exit 42; [ -d /proc/\$recorder ] || exit 43; if [ -n \"\$video_pid\" ]; then kill -0 \$video_pid 2>/dev/null || exit 45; fi; read now unused < /proc/uptime; [ \${now%%.*} -lt \$deadline ] || exit 43; $input_command keyevent $key; sleep $key_delay;"; done
for ((run=1; run<=runs; run++)); do
    [[ "$(adb -s "$device" shell pidof "$package" | tr -d '\r')" == "$pid" ]]
    adb -s "$device" shell rm -f "$trace_path" "$remote.log" "$video_path" "$remote.video.log"
    if [[ "$mode" == atrace ]]; then
        recorder="atrace -t $duration -b 4096 -c -a $package sched gfx view input dalvik"
        extension=atrace
    else
        recorder="perfetto --txt -c $config -o $trace_path"
        extension=perfetto-trace
    fi
    if [[ "$mode" == atrace ]]; then
        recording="$recorder > $trace_path 2>$remote.log"
    else
        recording="$recorder >$remote.log 2>&1"
    fi
    video_start=''
    if [[ "$video" == true ]]; then
        video_start="screenrecord --bugreport --monotonic-time --size 1280x720 --bit-rate 4000000 --time-limit $duration $video_path >$remote.video.log 2>&1 & video_pid=\$!;"
    fi
    # Perfetto may drop uid: do not signal or use kill -0 on it. Its config bounds
    # its lifetime; wait for that child. Stop the shell-owned video on any exit.
    adb -s "$device" shell "$guard guard || exit 42;
        recorder=''; video_pid='';
        stop_recorders() { status=\$?; trap - EXIT; if [ -n \"\$video_pid\" ]; then kill -INT \$video_pid 2>/dev/null; wait \$video_pid; fi; if [ -n \"\$recorder\" ]; then wait \$recorder; fi; exit \$status; }; trap stop_recorders EXIT;
        read started unused < /proc/uptime; deadline=\$((\${started%%.*} + $duration - 2));
        $recording & recorder=\$!; $video_start
        $events
        wait \$recorder; status=\$?; recorder=''; [ \$status = 0 ] || exit 44;
        if [ -n \"\$video_pid\" ]; then wait \$video_pid; status=\$?; video_pid=''; [ \$status = 0 ] || exit 45; fi"
    [[ "$(adb -s "$device" shell pidof "$package" | tr -d '\r')" == "$pid" ]]
    adb -s "$device" shell "$guard guard"
    adb -s "$device" pull "$trace_path" "$output/run-$run.$extension" >/dev/null
    [[ -s "$output/run-$run.$extension" ]]
    if [[ "$video" == true ]]; then
        adb -s "$device" pull "$video_path" "$output/run-$run.mp4" >/dev/null
        [[ -s "$output/run-$run.mp4" ]]
    fi
    sleep 2
done
uptime >> "$output/capture-metadata.txt"
adb -s "$device" shell rm -f "$trace_path" "$remote.log" "$config" "$video_path" "$remote.video.log"
printf 'Captured %s runs in %s; validate trace health and expected input count before analysis.\n' "$runs" "$output"
