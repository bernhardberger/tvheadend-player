#!/usr/bin/env bash
# One bounded batch on an already verified, foreground, warmed app. No install or launch.
# Invoke inside the existing ADB tunnel for LXC119. See docs/profiling.md for identity gates.
set -euo pipefail
umask 077
if (( $# < 6 )); then
    printf 'usage: bash tools/profiling/capture MODE DEVICE PACKAGE NEW_OUTPUT_DIR RUNS KEYCODE...\n' >&2
    exit 2
fi
mode=$1 device=$2 package=$3 output=$4 runs=$5
shift 5
key_delay=${TVHPLAYER_PROFILE_KEY_DELAY_SECONDS:-0.4}
# Zero requests back-to-back guarded dispatch, not a claimed fixed input cadence.
case "$key_delay" in 0|0.1|0.4) ;; *) exit 2 ;; esac
input_transport=${TVHPLAYER_PROFILE_INPUT_TRANSPORT:-java}
allow_back=${TVHPLAYER_PROFILE_ALLOW_BACK:-false}
case "$allow_back" in true|false) ;; *) exit 2 ;; esac
case "$input_transport" in
    java) input_command=input ;;
    cmd) input_command='cmd input' ;;
    *) exit 2 ;;
esac
case "$mode" in atrace|causal|frames|cpu|native-allocations) ;; *) exit 2 ;; esac
case "$package" in at.bernhardberger.tvhplayer|at.bernhardberger.tvhplayer.profile) ;; *) exit 2 ;; esac
[[ -n "$device" && "$runs" =~ ^[1-3]$ && $# -le 12 ]]
back_count=0
for key in "$@"; do
    case "$key" in
        4) [[ "$allow_back" == true ]] || exit 2; back_count=$((back_count + 1)); [[ "$back_count" == 1 ]] || exit 2 ;;
        19|20|21|22|166|167) ;;
        *) exit 2 ;;
    esac
done
[[ ! -e "$output" && -d "$(dirname "$output")" ]]
mkdir -m 700 "$output"
root=$(git rev-parse --show-toplevel)
pid=$(adb -s "$device" shell pidof "$package" | tr -d '\r')
[[ "$pid" =~ ^[0-9]+$ ]]
cleanup() {
    status=$?
    printf 'Stopping only %s after capture; the underlying app may become visible.\n' "$package" >&2
    if ! adb -s "$device" shell "am force-stop $package; ! pidof $package" >/dev/null; then
        printf 'Could not confirm package cleanup\n' >&2
        status=1
    fi
    exit "$status"
}
trap cleanup EXIT
{
    date -u '+utc=%FT%TZ'
    printf 'mode=%s\npackage=%s\npid=%s\nruns=%s\nkeycodes=%s\n' "$mode" "$package" "$pid" "$runs" "$*"
    printf 'key_delay_seconds=%s\n' "$key_delay"
    printf 'input_transport=%s\n' "$input_transport"
    printf 'allow_single_back=%s\n' "$allow_back"
    git rev-parse HEAD
    uptime
    adb -s "$device" shell 'for p in ro.product.manufacturer ro.product.model ro.product.device ro.product.name; do getprop "$p"; done'
} > "$output/capture-metadata.txt"
remote="/data/local/tmp/p44-${pid}"
config="/data/misc/perfetto-configs/p44-${pid}.pbtxt"
trace_path="$remote.trace"
if [[ "$mode" != atrace ]]; then
    trace_path="/data/misc/perfetto-traces/p44-${pid}.trace"
    adb -s "$device" push "$root/tools/profiling/$mode.pbtxt" "$config" >/dev/null
fi
# Guard every injection on-device. Its WindowManager work is recording overhead,
# not Player work; keep guarded batches distinct from older unguarded evidence.
guard="guard() { dumpsys window | grep 'mCurrentFocus=' | grep -Fq '$package/'; };"
events='sleep 1;'
for key in "$@"; do events+=" guard || exit 42; $input_command keyevent $key; sleep $key_delay;"; done
for ((run=1; run<=runs; run++)); do
    [[ "$(adb -s "$device" shell pidof "$package" | tr -d '\r')" == "$pid" ]]
    adb -s "$device" shell rm -f "$trace_path" "$remote.log"
    if [[ "$mode" == atrace ]]; then
        recorder="atrace -t 8 -b 4096 -c -a $package sched gfx view input dalvik"
        extension=atrace
    else
        recorder="perfetto --txt -c $config -o $trace_path"
        extension=perfetto-trace
    fi
    if [[ "$mode" == atrace ]]; then
        adb -s "$device" shell "$guard guard || exit 42; $recorder > $trace_path 2>$remote.log & recorder=\$!; $events wait \$recorder"
    else
        adb -s "$device" shell "$guard guard || exit 42; $recorder & recorder=\$!; $events wait \$recorder"
    fi
    [[ "$(adb -s "$device" shell pidof "$package" | tr -d '\r')" == "$pid" ]]
    adb -s "$device" shell "$guard guard"
    adb -s "$device" pull "$trace_path" "$output/run-$run.$extension" >/dev/null
    [[ -s "$output/run-$run.$extension" ]]
    sleep 2
done
uptime >> "$output/capture-metadata.txt"
adb -s "$device" shell rm -f "$trace_path" "$remote.log" "$config"
printf 'Captured %s runs in %s; validate trace health and expected input count before analysis.\n' "$runs" "$output"
