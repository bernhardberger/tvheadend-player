# Separate diagnostic capture: sampled stacks have different overhead from causal.pbtxt.
duration_ms: 8000
buffers { size_kb: 16384 fill_policy: RING_BUFFER }
data_sources {
  config {
    name: "linux.perf"
    perf_event_config {
      timebase { frequency: 99 }
      callstack_sampling {
        scope {
          target_cmdline: "at.bernhardberger.tvhplayer"
          target_cmdline: "at.bernhardberger.tvhplayer.profile"
        }
      }
    }
  }
}
data_sources { config { name: "linux.process_stats" process_stats_config { scan_all_processes_on_start: true record_thread_names: true } } }
