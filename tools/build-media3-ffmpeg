#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
MEDIA3_REVISION="630c1af455a16b8eb1ab36f49d82d9db799d7f5e"
FFMPEG_REVISION="c41ff724ede7da657762d61097e26fac296c53bf"
MEDIA3_VERSION="1.9.2"
FFMPEG_VERSION="n6.0.1"
FFMPEG_NDK_VERSION="26.1.10909125"
WRAPPER_NDK_VERSION="27.0.12077973"
ANDROID_API="28"

ANDROID_HOME="${ANDROID_HOME:-/opt/android-sdk}"
WORK_DIR="${TVHPLAYER_NATIVE_BUILD_DIR:-/tmp/tvhplayer-native-build}"
OUTPUT_DIR="${1:-$ROOT_DIR/build/native-release}"
FFMPEG_NDK="$ANDROID_HOME/ndk/$FFMPEG_NDK_VERSION"
WRAPPER_NDK="$ANDROID_HOME/ndk/$WRAPPER_NDK_VERSION"

for command in git java make tar sha256sum; do
    if ! command -v "$command" >/dev/null 2>&1; then
        printf 'error: required command is unavailable: %s\n' "$command" >&2
        exit 1
    fi
done
for required in \
    "$FFMPEG_NDK/source.properties" \
    "$WRAPPER_NDK/source.properties" \
    "$ANDROID_HOME/platforms/android-35/android.jar" \
    "$ANDROID_HOME/cmake/3.22.1/bin/cmake"; do
    if [[ ! -e "$required" ]]; then
        printf 'error: required Android toolchain input is unavailable: %s\n' "$required" >&2
        exit 1
    fi
done
if [[ -e "$WORK_DIR" ]]; then
    printf 'error: native build directory already exists: %s\n' "$WORK_DIR" >&2
    printf 'Remove it or set TVHPLAYER_NATIVE_BUILD_DIR to a new path.\n' >&2
    exit 1
fi

mkdir -p "$WORK_DIR" "$OUTPUT_DIR"
git clone --filter=blob:none https://github.com/androidx/media.git "$WORK_DIR/media"
git -C "$WORK_DIR/media" checkout --detach "$MEDIA3_REVISION"
git clone --filter=blob:none https://github.com/FFmpeg/FFmpeg.git "$WORK_DIR/ffmpeg"
git -C "$WORK_DIR/ffmpeg" checkout --detach "$FFMPEG_REVISION"

git -C "$WORK_DIR/media" apply \
    "$ROOT_DIR/app/libs/patches/media3-ffmpeg-disable-iconv.patch"
ln -s "$WORK_DIR/ffmpeg" \
    "$WORK_DIR/media/libraries/decoder_ffmpeg/src/main/jni/ffmpeg"

"$WORK_DIR/media/libraries/decoder_ffmpeg/src/main/jni/build_ffmpeg.sh" \
    "$WORK_DIR/media/libraries/decoder_ffmpeg/src/main" \
    "$FFMPEG_NDK" \
    "linux-x86_64" \
    "$ANDROID_API" \
    mp1 mp2 mp3

(
    cd "$WORK_DIR/media"
    ANDROID_HOME="$ANDROID_HOME" \
    ANDROID_SDK_ROOT="$ANDROID_HOME" \
    GRADLE_USER_HOME="$WORK_DIR/gradle-home" \
        ./gradlew \
        :lib-decoder-ffmpeg:assembleRelease \
        --no-daemon
)

aar_name="lib-decoder-ffmpeg-release.aar"
source_name="tvheadend-player-native-source-media3-${MEDIA3_VERSION}-ffmpeg-${FFMPEG_VERSION}.tar.gz"
cp "$WORK_DIR/media/libraries/decoder_ffmpeg/buildout/outputs/aar/$aar_name" \
    "$OUTPUT_DIR/$aar_name"

source_root="$WORK_DIR/corresponding-source"
source_package="$source_root/tvheadend-player-native-source"
mkdir -p "$source_package/media3" "$source_package/ffmpeg" "$source_package/build"
git -C "$WORK_DIR/media" archive "$MEDIA3_REVISION" | tar -x -C "$source_package/media3"
git -C "$WORK_DIR/ffmpeg" archive "$FFMPEG_REVISION" | tar -x -C "$source_package/ffmpeg"
cp "$ROOT_DIR/app/libs/patches/media3-ffmpeg-disable-iconv.patch" "$source_package/build/"
cp "$ROOT_DIR/app/libs/README.md" "$source_package/BUILD.md"
cp -R "$ROOT_DIR/app/libs/licenses" "$source_package/"

source_date_epoch="$(git -C "$WORK_DIR/media" show -s --format=%ct "$MEDIA3_REVISION")"
tar \
    --sort=name \
    --mtime="@$source_date_epoch" \
    --owner=0 \
    --group=0 \
    --numeric-owner \
    -czf "$OUTPUT_DIR/$source_name" \
    -C "$source_root" \
    tvheadend-player-native-source

(
    cd "$OUTPUT_DIR"
    sha256sum "$aar_name" "$source_name" > SHA256SUMS.native
)

printf 'Built %s and corresponding source in %s\n' "$aar_name" "$OUTPUT_DIR"
