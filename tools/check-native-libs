#!/usr/bin/env python3
"""Verify the byte-pinned released SDK native artifact, source, and packaged APK."""

from __future__ import annotations

import argparse
import hashlib
import struct
import sys
import tarfile
import zipfile
from pathlib import Path, PurePosixPath


ROOT = Path(__file__).resolve().parents[1]
SDK_COORDINATE = "at.bernhardberger.tvheadend:sdk-media3:0.3.0"
SDK_VERSION = "0.3.0"
EVIDENCE_DIRECTORY = ROOT / "app/build/released-sdk-evidence"
SDK_AAR_NAME = f"sdk-media3-{SDK_VERSION}.aar"
FFMPEG_SOURCES_NAME = f"sdk-media3-{SDK_VERSION}-ffmpeg-sources.tar.xz"
EXPECTED_AAR_SHA256 = "a3d199ef83848a56b6ca0e8ef396348bd50be740f5e672967515d77b8eb53616"
EXPECTED_FFMPEG_SOURCES_SHA256 = "9eeca8490f794574185986c0df7800d65ccca2980f57dc26b630a398581d7929"
EXPECTED_STANDARD_SOURCE_SHA256 = {
    f"sdk-android-{SDK_VERSION}-sources.jar": "2de17050fd30a543701a99605cbbce8dc8b0e3754fdc0ffce3282c8e0b095488",
    f"sdk-core-{SDK_VERSION}-sources.jar": "85afacb93bf3dbc7df58b99f9cb337bb15d3113fdf1c235970570fd850bf54b7",
    f"sdk-media3-{SDK_VERSION}-sources.jar": "6cd20d9a7cab474a6bbc9ef832649f1cbfdca628a8011c2ecbf7a92c8348a877",
    f"sdk-playback-{SDK_VERSION}-sources.jar": "980c499ad755215e83efd0953da92ea6e0a6f660c7f70f24e153d522ae271945",
}
EXPECTED_ABIS = ("arm64-v8a", "armeabi-v7a", "x86", "x86_64")
# Android's 16 KiB page-size contract applies to the shipped 64-bit targets.
ALIGNMENT_ABIS = ("arm64-v8a", "x86_64")
EXPECTED_LIBRARY = "libffmpegJNI.so"
EXPECTED_MINIMUM_ALIGNMENT = 16384
EXPECTED_EMBEDDED_DECODER = "libs/media3-decoder-ffmpeg-1.11.0.jar"
REQUIRED_SOURCE_ENTRIES = {
    "ffmpeg/COPYING.LGPLv2.1",
    "ffmpeg/LICENSE.md",
    "ffmpeg/configure",
    "ffmpeg/libavcodec/ac3dec.c",
    "ffmpeg/libavcodec/eac3dec.c",
    "ffmpeg/libavcodec/mpegaudiodec_fixed.c",
    "media3-1.11.0/LICENSE",
    "media3-1.11.0/libraries/decoder_ffmpeg/README.md",
    "media3-1.11.0/libraries/decoder_ffmpeg/src/main/java/androidx/media3/decoder/ffmpeg/FfmpegAudioRenderer.java",
    "media3-1.11.0/libraries/decoder_ffmpeg/src/main/jni/build_ffmpeg.sh",
    "media3-1.11.0/libraries/decoder_ffmpeg/src/main/jni/ffmpeg_jni.cc",
}
PT_LOAD = 1


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def regular_file(path: Path, label: str, errors: list[str]) -> bool:
    if not path.is_file() or path.is_symlink():
        errors.append(f"{label} is missing or is not a regular file: {path}")
        return False
    return True


def require_hash(path: Path, expected: str, label: str, errors: list[str]) -> None:
    if not regular_file(path, label, errors):
        return
    actual = sha256(path)
    if actual != expected:
        errors.append(f"{label} SHA-256 {actual} does not match released hash {expected}")


def load_alignments(data: bytes, label: str) -> list[int]:
    if len(data) < 16 or data[:4] != b"\x7fELF":
        raise ValueError(f"{label}: not an ELF shared library")
    elf_class = data[4]
    byte_order = data[5]
    if byte_order == 1:
        endian = "<"
    elif byte_order == 2:
        endian = ">"
    else:
        raise ValueError(f"{label}: unsupported ELF byte order {byte_order}")

    if elf_class == 1:
        if len(data) < 52:
            raise ValueError(f"{label}: truncated ELF32 header")
        ph_offset = struct.unpack_from(f"{endian}I", data, 28)[0]
        ph_entry_size = struct.unpack_from(f"{endian}H", data, 42)[0]
        ph_count = struct.unpack_from(f"{endian}H", data, 44)[0]
        align_offset, align_format = 28, "I"
    elif elf_class == 2:
        if len(data) < 64:
            raise ValueError(f"{label}: truncated ELF64 header")
        ph_offset = struct.unpack_from(f"{endian}Q", data, 32)[0]
        ph_entry_size = struct.unpack_from(f"{endian}H", data, 54)[0]
        ph_count = struct.unpack_from(f"{endian}H", data, 56)[0]
        align_offset, align_format = 48, "Q"
    else:
        raise ValueError(f"{label}: unsupported ELF class {elf_class}")

    alignments: list[int] = []
    for index in range(ph_count):
        entry = ph_offset + index * ph_entry_size
        if entry + ph_entry_size > len(data):
            raise ValueError(f"{label}: truncated program-header table")
        if struct.unpack_from(f"{endian}I", data, entry)[0] == PT_LOAD:
            alignments.append(
                struct.unpack_from(f"{endian}{align_format}", data, entry + align_offset)[0]
            )
    if not alignments:
        raise ValueError(f"{label}: ELF has no load segments")
    return alignments


def validate_decoder_entries(
    archive: zipfile.ZipFile,
    prefix: str,
    label: str,
    errors: list[str],
) -> dict[str, bytes]:
    names = archive.namelist()
    if len(names) != len(set(names)):
        errors.append(f"{label}: duplicate ZIP entries are forbidden")
    expected = {f"{prefix}/{abi}/{EXPECTED_LIBRARY}" for abi in EXPECTED_ABIS}
    actual = {name for name in names if name.endswith(f"/{EXPECTED_LIBRARY}")}
    if actual != expected:
        errors.append(f"{label}: decoder entries {sorted(actual)} do not match {sorted(expected)}")

    libraries: dict[str, bytes] = {}
    for abi in EXPECTED_ABIS:
        entry = f"{prefix}/{abi}/{EXPECTED_LIBRARY}"
        if entry not in actual:
            continue
        data = archive.read(entry)
        libraries[abi] = data
        if abi not in ALIGNMENT_ABIS:
            continue
        try:
            below_minimum = [
                alignment
                for alignment in load_alignments(data, f"{label}!/{entry}")
                if alignment < EXPECTED_MINIMUM_ALIGNMENT
            ]
        except ValueError as error:
            errors.append(str(error))
            continue
        if below_minimum:
            errors.append(
                f"{label}!/{entry}: load alignment below "
                f"{EXPECTED_MINIMUM_ALIGNMENT}: {below_minimum}"
            )
    return libraries


def validate_aar(path: Path, errors: list[str]) -> dict[str, bytes]:
    if not regular_file(path, "released SDK Media3 AAR", errors):
        return {}
    require_hash(path, EXPECTED_AAR_SHA256, "released SDK Media3 AAR", errors)
    try:
        with zipfile.ZipFile(path) as archive:
            names = archive.namelist()
            if names.count(EXPECTED_EMBEDDED_DECODER) != 1:
                errors.append(
                    "released SDK Media3 AAR must contain exactly "
                    f"{EXPECTED_EMBEDDED_DECODER}"
                )
            native_entries = [name for name in names if name.startswith("jni/") and name.endswith(".so")]
            expected_native = {f"jni/{abi}/{EXPECTED_LIBRARY}" for abi in EXPECTED_ABIS}
            if set(native_entries) != expected_native or len(native_entries) != len(expected_native):
                errors.append(
                    f"released SDK Media3 AAR native entries {native_entries} do not match "
                    f"{sorted(expected_native)}"
                )
            return validate_decoder_entries(archive, "jni", "released SDK Media3 AAR", errors)
    except (OSError, zipfile.BadZipFile) as error:
        errors.append(f"released SDK Media3 AAR is unreadable: {error}")
        return {}


def safe_archive_path(name: str) -> bool:
    path = PurePosixPath(name)
    return bool(name) and not path.is_absolute() and ".." not in path.parts and "\\" not in name


def validate_source_members(members: list[tarfile.TarInfo], errors: list[str]) -> None:
    names = [member.name for member in members]
    if len(names) != len(set(names)):
        errors.append("released FFmpeg corresponding source contains duplicate entries")
    unsafe = sorted(name for name in names if not safe_archive_path(name))
    if unsafe:
        errors.append(f"released FFmpeg corresponding source contains unsafe paths: {unsafe}")
    unexpected_roots = sorted({PurePosixPath(name).parts[0] for name in names if name} - {"ffmpeg", "media3-1.11.0"})
    if unexpected_roots:
        errors.append(f"released FFmpeg corresponding source has unexpected roots: {unexpected_roots}")
    regular_names = {member.name for member in members if member.isfile()}
    missing = sorted(REQUIRED_SOURCE_ENTRIES - regular_names)
    if missing:
        errors.append(f"released FFmpeg corresponding source is missing regular files: {missing}")
    unsafe_links = []
    for member in members:
        if not (member.issym() or member.islnk()):
            continue
        target = (
            PurePosixPath(member.name).parent.joinpath(member.linkname)
            if member.issym()
            else PurePosixPath(member.linkname)
        )
        depth = 0
        escaped = False
        for part in target.parts:
            if part in ("", "."):
                continue
            if part == "..":
                depth -= 1
                if depth < 0:
                    escaped = True
                    break
            else:
                depth += 1
        if escaped or PurePosixPath(member.linkname).is_absolute() or "\\" in member.linkname:
            unsafe_links.append(f"{member.name}->{member.linkname}")
    if unsafe_links:
        errors.append(f"released FFmpeg corresponding source has unsafe links: {unsafe_links}")
    special = sorted(
        member.name
        for member in members
        if not (member.isfile() or member.isdir() or member.issym() or member.islnk())
    )
    if special:
        errors.append(f"released FFmpeg corresponding source has special entries: {special}")


def validate_corresponding_source(path: Path, errors: list[str]) -> None:
    if not regular_file(path, "released FFmpeg corresponding source", errors):
        return
    require_hash(
        path,
        EXPECTED_FFMPEG_SOURCES_SHA256,
        "released FFmpeg corresponding source",
        errors,
    )
    try:
        with tarfile.open(path, mode="r:xz") as archive:
            validate_source_members(archive.getmembers(), errors)
    except (OSError, tarfile.TarError) as error:
        errors.append(f"released FFmpeg corresponding source is unreadable: {error}")


def validate_apk(path: Path, aar_libraries: dict[str, bytes], errors: list[str]) -> None:
    if not regular_file(path, "packaged APK", errors):
        return
    try:
        with zipfile.ZipFile(path) as archive:
            apk_libraries = validate_decoder_entries(archive, "lib", "packaged APK", errors)
    except (OSError, zipfile.BadZipFile) as error:
        errors.append(f"packaged APK is unreadable: {error}")
        return
    for abi in EXPECTED_ABIS:
        if abi in aar_libraries and abi in apk_libraries and aar_libraries[abi] != apk_libraries[abi]:
            errors.append(
                f"packaged APK {abi}/{EXPECTED_LIBRARY} differs from the released SDK AAR"
            )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--release",
        action="store_true",
        help="default to the unsigned release APK instead of the debug APK",
    )
    parser.add_argument("--apk", type=Path, help="APK to inspect instead of the default")
    parser.add_argument(
        "--evidence-directory",
        type=Path,
        default=EVIDENCE_DIRECTORY,
        help="Gradle-resolved released SDK evidence directory",
    )
    args = parser.parse_args()

    evidence_directory = args.evidence_directory
    if not evidence_directory.is_absolute():
        evidence_directory = ROOT / evidence_directory
    apk = args.apk or ROOT / (
        "app/build/outputs/apk/release/app-release-unsigned.apk"
        if args.release
        else "app/build/outputs/apk/debug/app-debug.apk"
    )
    if not apk.is_absolute():
        apk = ROOT / apk

    errors: list[str] = []
    aar = evidence_directory / SDK_AAR_NAME
    sources = evidence_directory / FFMPEG_SOURCES_NAME
    expected_evidence_names = {
        SDK_AAR_NAME,
        FFMPEG_SOURCES_NAME,
        *EXPECTED_STANDARD_SOURCE_SHA256,
    }
    actual_evidence_names = (
        {path.name for path in evidence_directory.iterdir() if path.is_file()}
        if evidence_directory.is_dir()
        else set()
    )
    if actual_evidence_names != expected_evidence_names:
        errors.append(
            f"released SDK evidence files {sorted(actual_evidence_names)} do not match "
            f"{sorted(expected_evidence_names)}"
        )
    for name, expected_hash in EXPECTED_STANDARD_SOURCE_SHA256.items():
        require_hash(evidence_directory / name, expected_hash, f"released SDK source {name}", errors)
    validate_corresponding_source(sources, errors)
    aar_libraries = validate_aar(aar, errors)
    validate_apk(apk, aar_libraries, errors)

    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    mode = "release" if args.release else "debug"
    print(
        f"Released SDK native gate passed: {SDK_COORDINATE}, SHA-256 "
        f"{EXPECTED_AAR_SHA256}, {len(EXPECTED_ABIS)} shipped ABIs, 16 KiB ELF "
        f"alignment on {', '.join(ALIGNMENT_ABIS)}, complete corresponding source, "
        f"and matching {mode} APK"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
