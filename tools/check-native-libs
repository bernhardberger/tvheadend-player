class DuplicateJsonKey(ValueError):
    pass


def reject_duplicate_json_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise DuplicateJsonKey(f"duplicate JSON object key {key!r}")
        result[key] = value
    return result


def parse_json(data: bytes, label: str, errors: list[str]) -> object | None:
    try:
        return json.loads(
            data.decode("utf-8"),
            object_pairs_hook=reject_duplicate_json_keys,
        )
    except (UnicodeError, json.JSONDecodeError, DuplicateJsonKey) as exc:
        errors.append(f"{label}: invalid JSON: {exc}")
        return None


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def one_regular_file(
    directory: Path,
    pattern: str,
    label: str,
    errors: list[str],
) -> Path | None:
    matches = sorted(directory.glob(pattern)) if directory.is_dir() else []
    regular = [path for path in matches if path.is_file() and not path.is_symlink()]
    if len(regular) != 1 or len(matches) != 1:
        errors.append(
            f"{label}: expected exactly one regular {pattern!r} file, "
            f"found {[path.name for path in matches]}"
        )
        return None
    return regular[0]


def load_alignments(data: bytes, label: str) -> list[int]:
    if len(data) < 16 or data[:4] != b"\x7fELF":
        raise ValueError(f"{label}: not an ELF shared library")

    elf_class = data[4]
    byte_order = data[5]
    if byte_order == 1:
        endian = "<"
    elif byte_order == 2:
        endian = ">"
    else:
        raise ValueError(f"{label}: unsupported ELF byte order {byte_order}")

    if elf_class == 1:
        if len(data) < 52:
            raise ValueError(f"{label}: truncated ELF32 header")
        ph_offset = struct.unpack_from(f"{endian}I", data, 28)[0]
        ph_entry_size = struct.unpack_from(f"{endian}H", data, 42)[0]
        ph_count = struct.unpack_from(f"{endian}H", data, 44)[0]
        align_offset = 28
        align_format = "I"
    elif elf_class == 2:
        if len(data) < 64:
            raise ValueError(f"{label}: truncated ELF64 header")
        ph_offset = struct.unpack_from(f"{endian}Q", data, 32)[0]
        ph_entry_size = struct.unpack_from(f"{endian}H", data, 54)[0]
        ph_count = struct.unpack_from(f"{endian}H", data, 56)[0]
        align_offset = 48
        align_format = "Q"
    else:
        raise ValueError(f"{label}: unsupported ELF class {elf_class}")

    alignments: list[int] = []
    for index in range(ph_count):
        entry = ph_offset + index * ph_entry_size
        if entry + ph_entry_size > len(data):
            raise ValueError(f"{label}: truncated program-header table")
        segment_type = struct.unpack_from(f"{endian}I", data, entry)[0]
        if segment_type == PT_LOAD:
            alignments.append(
                struct.unpack_from(
                    f"{endian}{align_format}",
                    data,
                    entry + align_offset,
                )[0]
            )
    if not alignments:
        raise ValueError(f"{label}: ELF has no load segments")
    return alignments


def validate_native_archive(
    archive: zipfile.ZipFile,
    prefix: str,
    label: str,
    require_only_decoder_library: bool,
    errors: list[str],
) -> dict[str, bytes]:
    expected_entries = {
        f"{prefix}/{abi}/{EXPECTED_LIBRARY}" for abi in EXPECTED_ABIS
    }
    native_entry_list = [
        name
        for name in archive.namelist()
        if name.startswith(f"{prefix}/") and name.endswith(".so")
    ]
    if len(native_entry_list) != len(set(native_entry_list)):
        errors.append(f"{label}: duplicate native ZIP entries are forbidden")
    decoder_entry_list = [
        name
        for name in native_entry_list
        if name.endswith(f"/{EXPECTED_LIBRARY}")
    ]
    checked_entries = (
        set(native_entry_list)
        if require_only_decoder_library
        else set(decoder_entry_list)
    )
    if checked_entries != expected_entries:
        errors.append(
            f"{label}: decoder entries {sorted(checked_entries)} do not match "
            f"{sorted(expected_entries)}"
        )

    libraries: dict[str, bytes] = {}
    for abi in EXPECTED_ABIS:
        entry = f"{prefix}/{abi}/{EXPECTED_LIBRARY}"
        if entry not in checked_entries:
            continue
        data = archive.read(entry)
        libraries[abi] = data
        try:
            alignments = load_alignments(data, f"{label}!/{entry}")
        except ValueError as exc:
            errors.append(str(exc))
            continue
        below_minimum = [
            alignment
            for alignment in alignments
            if alignment < EXPECTED_MINIMUM_ALIGNMENT
        ]
        if below_minimum:
            errors.append(
                f"{label}!/{entry}: load alignment below "
                f"{EXPECTED_MINIMUM_ALIGNMENT}: {below_minimum}"
            )
    return libraries


def validate_snapshot_metadata(
    metadata_path: Path,
    artifacts: dict[tuple[str, str | None], Path],
    errors: list[str],
) -> None:
    try:
        root = ElementTree.parse(metadata_path).getroot()
    except (OSError, ElementTree.ParseError) as exc:
        errors.append(f"published decoder metadata is unreadable: {exc}")
        return

    expected_identity = {
        "groupId": SDK_GROUP,
        "artifactId": SDK_MODULE,
        "version": SDK_VERSION,
    }
    for element, expected in expected_identity.items():
        actual = root.findtext(element)
        if actual != expected:
            errors.append(
                f"published decoder metadata {element} is {actual!r}, expected {expected!r}"
            )

    selected: dict[tuple[str, str | None], str] = {}
    for entry in root.findall("./versioning/snapshotVersions/snapshotVersion"):
        extension = entry.findtext("extension")
        value = entry.findtext("value")
        classifier = entry.findtext("classifier")
        if not extension or not value:
            errors.append("published decoder metadata has an incomplete snapshot entry")
            continue
        key = extension, classifier
        if key in selected:
            errors.append(f"published decoder metadata repeats snapshot entry {key}")
        selected[key] = value

    if set(selected) != set(artifacts):
        errors.append(
            f"published decoder snapshot variants {sorted(map(str, selected))} do not "
            f"match {sorted(map(str, artifacts))}"
        )
        return
    for (extension, classifier), value in selected.items():
        classifier_suffix = f"-{classifier}" if classifier else ""
        expected_name = f"{SDK_MODULE}-{value}{classifier_suffix}.{extension}"
        if artifacts[(extension, classifier)].name != expected_name:
            errors.append(
                f"published decoder metadata selects {expected_name}, found "
                f"{artifacts[(extension, classifier)].name}"
            )


def validate_pom(path: Path, errors: list[str]) -> None:
    try:
        root = ElementTree.parse(path).getroot()
    except (OSError, ElementTree.ParseError) as exc:
        errors.append(f"published decoder POM is unreadable: {exc}")
        return

    namespace = {"m": "http://maven.apache.org/POM/4.0.0"}
    expected_identity = {
        "groupId": SDK_GROUP,
        "artifactId": SDK_MODULE,
        "version": SDK_VERSION,
        "packaging": "aar",
    }
    for element, expected in expected_identity.items():
        actual = root.findtext(f"m:{element}", namespaces=namespace)
        if actual != expected:
            errors.append(
                f"published decoder POM {element} is {actual!r}, expected {expected!r}"
            )

    properties_element = root.find("m:properties", namespace)
    properties = (
        {
            child.tag.rsplit("}", 1)[-1]: child.text
            for child in properties_element
        }
        if properties_element is not None
        else {}
    )
    expected_properties = {
        "tvheadend.sdk.native.aar.sha256": EXPECTED_AAR_SHA256,
        "tvheadend.sdk.native.provenance.path": (
            f"{METADATA_ROOT}/native-dependencies.json"
        ),
        "tvheadend.sdk.native.build.path": (
            f"{METADATA_ROOT}/tools/build-media3-ffmpeg"
        ),
        "tvheadend.sdk.native.media3.revision": EXPECTED_MEDIA3_REVISION,
        "tvheadend.sdk.native.ffmpeg.revision": EXPECTED_FFMPEG_REVISION,
        "tvheadend.sdk.native.media3.license": "Apache-2.0",
        "tvheadend.sdk.native.ffmpeg.license": "LGPL-2.1-or-later",
        "tvheadend.sdk.native.corresponding-source": (
            "tools/build-media3-ffmpeg generates the exact Media3 and FFmpeg source "
            "archive required beside every APK release"
        ),
    }
    for name, expected in expected_properties.items():
        if properties.get(name) != expected:
            errors.append(
                f"published decoder POM property {name} is {properties.get(name)!r}, "
                f"expected {expected!r}"
            )

    licenses = {
        element.text
        for element in root.findall("./m:licenses/m:license/m:name", namespace)
        if element.text
    }
    required_license_markers = (
        "GNU General Public License v3.0",
        "Apache",
        "GNU Lesser General Public License",
    )
    for marker in required_license_markers:
        if not any(marker in license_name for license_name in licenses):
            errors.append(f"published decoder POM lacks the {marker} license declaration")


def validate_module_metadata(
    path: Path,
    aar: Path,
    sources: Path,
    errors: list[str],
) -> None:
    metadata = parse_json(path.read_bytes(), "published decoder module metadata", errors)
    if not isinstance(metadata, dict):
        return
    expected_component = {
        "group": SDK_GROUP,
        "module": SDK_MODULE,
        "version": SDK_VERSION,
    }
    component = metadata.get("component")
    if not isinstance(component, dict) or any(
        component.get(name) != value for name, value in expected_component.items()
    ):
        errors.append(
            f"published decoder module component {component!r} does not match "
            f"{expected_component!r}"
        )

    variants = metadata.get("variants")
    if not isinstance(variants, list):
        errors.append("published decoder module metadata lacks variants")
        return
    runtime_variants = [
        variant
        for variant in variants
        if isinstance(variant, dict)
        and isinstance(variant.get("attributes"), dict)
        and variant["attributes"].get("org.gradle.usage") == "java-runtime"
        and variant["attributes"].get("org.gradle.libraryelements") == "aar"
    ]
    source_variants = [
        variant
        for variant in variants
        if isinstance(variant, dict)
        and isinstance(variant.get("attributes"), dict)
        and variant["attributes"].get("org.gradle.docstype") == "sources"
    ]
    if len(runtime_variants) != 1:
        errors.append(
            f"published decoder metadata has {len(runtime_variants)} runtime AAR variants"
        )
    else:
        attributes = runtime_variants[0]["attributes"]
        if attributes.get("org.gradle.jvm.version") != 17:
            errors.append("published decoder runtime metadata must target JVM 17")
        files = runtime_variants[0].get("files")
        if not isinstance(files, list) or len(files) != 1:
            errors.append("published decoder runtime metadata must declare one AAR")
        elif files[0].get("sha256") != sha256(aar):
            errors.append("published decoder runtime metadata AAR hash does not match its file")
    if len(source_variants) != 1:
        errors.append(
            f"published decoder metadata has {len(source_variants)} sources variants"
        )
    else:
        files = source_variants[0].get("files")
        if not isinstance(files, list) or len(files) != 1:
            errors.append("published decoder sources metadata must declare one sources JAR")
        elif files[0].get("sha256") != sha256(sources):
            errors.append(
                "published decoder sources metadata hash does not match its file"
            )


def validate_provenance(
    manifest: object,
    release: bool,
    errors: list[str],
) -> None:
    if manifest != EXPECTED_PROVENANCE:
        mode = "release " if release else ""
        errors.append(
            f"published decoder {mode}provenance does not match the pinned reviewed manifest"
        )


def validate_published_sources(path: Path, release: bool, errors: list[str]) -> None:
    required_entries = set(EXPECTED_SOURCE_ENTRY_SHA256)
    try:
        with zipfile.ZipFile(path) as archive:
            names = set(archive.namelist())
            missing = required_entries - names
            if missing:
                errors.append(
                    f"published decoder sources are missing {sorted(missing)}"
                )
            for entry, expected_hash in EXPECTED_SOURCE_ENTRY_SHA256.items():
                if entry not in names:
                    continue
                actual_hash = sha256_bytes(archive.read(entry))
                if actual_hash != expected_hash:
                    errors.append(
                        f"published decoder source {entry} SHA-256 {actual_hash} does "
                        f"not match {expected_hash}"
                    )

            manifest_entry = f"{METADATA_ROOT}/native-dependencies.json"
            if manifest_entry not in names:
                return
            manifest = parse_json(
                archive.read(manifest_entry),
                "published decoder provenance",
                errors,
            )
            if not isinstance(manifest, dict):
                return
            validate_provenance(manifest, release, errors)
    except (OSError, zipfile.BadZipFile) as exc:
        errors.append(f"published decoder sources JAR is unreadable: {exc}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--release",
        action="store_true",
        help="require complete release provenance and default to the unsigned release APK",
    )
    parser.add_argument(
        "--apk",
        type=Path,
        help="APK to inspect instead of the default debug or unsigned release APK",
    )
    args = parser.parse_args()

    apk = args.apk
    if apk is None:
        apk = ROOT / (
            "app/build/outputs/apk/release/app-release-unsigned.apk"
            if args.release
            else "app/build/outputs/apk/debug/app-debug.apk"
        )
    elif not apk.is_absolute():
        apk = ROOT / apk

    errors: list[str] = []
    metadata = one_regular_file(
        VERSION_DIRECTORY,
        "maven-metadata.xml",
        "published decoder snapshot metadata",
        errors,
    )
    aar = one_regular_file(
        VERSION_DIRECTORY,
        f"{SDK_MODULE}-*.aar",
        "published decoder AAR",
        errors,
    )
    pom = one_regular_file(
        VERSION_DIRECTORY,
        f"{SDK_MODULE}-*.pom",
        "published decoder POM",
        errors,
    )
    module = one_regular_file(
        VERSION_DIRECTORY,
        f"{SDK_MODULE}-*.module",
        "published decoder Gradle metadata",
        errors,
    )
    sources = one_regular_file(
        VERSION_DIRECTORY,
        f"{SDK_MODULE}-*-sources.jar",
        "published decoder sources JAR",
        errors,
    )
    if not apk.is_file() or apk.is_symlink():
        errors.append(f"packaged APK is missing or not a regular file: {apk}")

    required = (metadata, aar, pom, module, sources)
    if all(path is not None for path in required):
        assert metadata is not None
        assert aar is not None
        assert pom is not None
        assert module is not None
        assert sources is not None
        validate_snapshot_metadata(
            metadata,
            {
                ("aar", None): aar,
                ("pom", None): pom,
                ("module", None): module,
                ("jar", "sources"): sources,
            },
            errors,
        )
        validate_pom(pom, errors)
        validate_module_metadata(module, aar, sources, errors)
        validate_published_sources(sources, args.release, errors)

        actual_sources_hash = sha256(sources)
        if actual_sources_hash != EXPECTED_SOURCES_SHA256:
            errors.append(
                f"published decoder sources SHA-256 {actual_sources_hash} does not "
                f"match {EXPECTED_SOURCES_SHA256}"
            )

        actual_aar_hash = sha256(aar)
        if actual_aar_hash != EXPECTED_AAR_SHA256:
            errors.append(
                f"published decoder AAR SHA-256 {actual_aar_hash} does not match "
                f"{EXPECTED_AAR_SHA256}"
            )
        aar_libraries: dict[str, bytes] = {}
        try:
            with zipfile.ZipFile(aar) as archive:
                aar_libraries = validate_native_archive(
                    archive,
                    "jni",
                    "published decoder AAR",
                    True,
                    errors,
                )
        except (OSError, zipfile.BadZipFile) as exc:
            errors.append(f"published decoder AAR is unreadable: {exc}")

        if apk.is_file() and not apk.is_symlink():
            try:
                with zipfile.ZipFile(apk) as archive:
                    apk_libraries = validate_native_archive(
                        archive,
                        "lib",
                        "packaged APK",
                        False,
                        errors,
                    )
            except (OSError, zipfile.BadZipFile) as exc:
                errors.append(f"packaged APK is unreadable: {exc}")
                apk_libraries = {}
            for abi in EXPECTED_ABIS:
                if abi not in aar_libraries or abi not in apk_libraries:
                    continue
                if aar_libraries[abi] != apk_libraries[abi]:
                    errors.append(
                        f"packaged APK {abi}/{EXPECTED_LIBRARY} differs from the "
                        "published decoder AAR"
                    )

    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1

    mode = "release" if args.release else "debug"
    print(
        f"External decoder gate passed: {SDK_GROUP}:{SDK_MODULE}:{SDK_VERSION}, "
        f"SHA-256 {EXPECTED_AAR_SHA256}, {len(EXPECTED_ABIS)} ABIs, "
        f"{EXPECTED_MINIMUM_ALIGNMENT}-byte ELF alignment, and matching {mode} APK"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
