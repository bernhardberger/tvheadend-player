def make_fixture():
    rng = random.Random(SEED)
    channels, events, gaps = [], [], []
    profiles = dict(news=news, entertainment=general, sports=sports, kids=kids, nature=docs, live=live, anime=anime)
    for number, (slug, name, genre) in enumerate(LINEUP, 1):
        channel = dict(channel_id=f"ch-{slug}", number=number, name=name, genre=genre,
                       locale="de" if slug in ("city-desk", "foundry-docs") else "en",
                       picon=f"{slug}.png" if slug in PICONS else None)
        channels.append(channel)
        s = Schedule(channel, events, gaps, rng)
        profile = profiles[genre]
        if slug == "skyglass-weather":
            profile = weather
        elif slug in ("harbor-lights", "quiet-hours"):
            profile = music
        elif slug == "coastal-miles":
            profile = travel
        for day in range(4):
            if slug == "harbor-sport-plus" and day == 1:
                s.gap(54 * 60, "sparse-guide-ended")
                break
            if s.cursor >= END:
                break
            profile(s, day)
            expected = min(START + timedelta(days=day + 1, hours=6 if profile == travel else 0), END)
            require(s.cursor == expected, f"Profile length mismatch: {slug} day {day}: {s.cursor}")
    # Merge consecutive off-air portions across calendar-day boundaries.
    merged = []
    for gap in gaps:
        if merged and all(merged[-1][key] == gap[key] for key in ("channel_id", "reason")) and merged[-1]["stop"] == gap["start"]:
            merged[-1]["stop"] = gap["stop"]
        else:
            merged.append(gap.copy())
    events.sort(key=lambda e: (e["start"], e["channel_id"]))
    fixture = dict(reference_start=iso(START), timezone="Europe/Vienna", seed=SEED,
                   generator="tools/generate-fixture-epg", source=dict(path="catalogue/epg.json", sha256=SOURCE_SHA),
                   coverage_stop=iso(END), snapshot_time=iso(NOW), channels=channels,
                   events=events, gaps=merged, dvr_fixtures=[])
    def record(channel, local, state, **extra):
        start = iso(datetime.fromisoformat(local).replace(tzinfo=TZ))
        e = next(e for e in events if e["channel_id"] == channel and e["start"] == start)
        fixture["dvr_fixtures"].append(dict(dvr_id=f"dvr-{len(fixture['dvr_fixtures']) + 1:02}",
                                          event_id=e["event_id"], channel_id=channel,
                                          title=e["title"], state=state, **extra))
    record("ch-amber-stage", "2026-09-14T20:15", "completed")
    record("ch-ridge-cycle", "2026-09-14T12:00", "failed", error="No input signal (fictional)")
    record("ch-northline-news", "2026-09-15T19:30", "recording")
    record("ch-amber-stage", "2026-09-15T20:15", "scheduled", series_id="series-parcel")
    record("ch-amber-stage", "2026-09-15T21:00", "scheduled", series_id="series-parcel")
    record("ch-amber-stage", "2026-09-16T14:00", "scheduled", series_id="ent-glass-harbor")
    record("ch-harbor-sport", "2026-09-16T19:00", "scheduled", conflict_group="one-tuner-evening", conflict=True)
    record("ch-river-court", "2026-09-16T19:00", "scheduled", conflict_group="one-tuner-evening", conflict=True)
    return fixture


def validate(fixture):
    events, gaps = fixture["events"], fixture["gaps"]
    require(set(DURATION_RANGES) == set(PROGRAMMES), "Every programme needs a duration contract")
    require(all(0 < low <= high for low, high in DURATION_RANGES.values()), "Invalid duration contract")
    require(DELIBERATE_LOOPS <= set(PROGRAMMES) and
            all(PROGRAMMES[p]["genre"] in ("weather", "music") for p in DELIBERATE_LOOPS), "Invalid deliberate loop")
    require(set(EPISODE_TITLES) == {p for p, data in PROGRAMMES.items() if "series" in data["genre"]},
            "Every series needs its own episode catalogue")
    catalogue_titles = [title for titles in EPISODE_TITLES.values() for title in titles]
    require(len(set(catalogue_titles)) == len(catalogue_titles), "Episode catalogues reuse a subtitle")
    channels = {c["channel_id"]: c for c in fixture["channels"]}
    require(len(channels) == 27, "Expected all 27 original channels")
    require(len(fixture["channels"]) == 27 and {c["number"] for c in channels.values()} == set(range(1, 28)),
            "Duplicate channel identities or numbers")
    require(all(g["channel_id"] in channels and g["reason"] in
                ("off-air", "missing-guide-data", "sparse-guide-ended") for g in gaps), "Invalid declared gap")
    require(len({e["event_id"] for e in events}) == len(events), "Duplicate event IDs")
    require({e["programme_id"] for e in events} >= ART_IDS, "A reused art programme is missing")
    stats = []
    for channel_id, channel in channels.items():
        rows = sorted((e for e in events if e["channel_id"] == channel_id), key=lambda e: e["start"])
        for previous, following in zip(rows, rows[1:]):
            programme = previous["programme_id"]
            require(not (previous["stop"] == following["start"] and programme == following["programme_id"] and
                         "series" not in PROGRAMMES[programme]["genre"] and programme not in DELIBERATE_LOOPS),
                    f"Adjacent non-series programme without a declared loop: {programme}")
        holes = [g for g in gaps if g["channel_id"] == channel_id]
        intervals = sorted(rows + holes, key=lambda e: e["start"])
        cursor = START
        for interval in intervals:
            start, stop = instant(interval["start"]), instant(interval["stop"])
            require(start == cursor, f"Undeclared gap or overlap: {channel_id} {start}")
            require(start < stop <= END, f"Invalid interval: {channel_id} {start}")
            require(start.second == stop.second == start.microsecond == stop.microsecond == 0,
                    "Non-whole-minute interval")
            cursor = stop
        require(cursor == END, f"Incomplete coverage: {channel_id}")
        if channel["picon"]:
            require((ROOT / "app/src/test/resources/fixture-art/picons" / channel["picon"]).is_file(),
                    f"Missing pack picon: {channel['picon']}")
        durations = [e["duration_min"] for e in rows]
        off_grid = sum(instant(e["start"]).astimezone(TZ).minute not in (0, 15, 30, 45) for e in rows)
        stats.append(f"{channel_id:23} events={len(rows):3} min={min(durations):3} max={max(durations):3} "
                     f"median={statistics.median(durations):5g} off_grid={off_grid:3} gaps={len(holes)}")
    subtitle_owners, episode_subtitles = {}, {}
    channel_episodes = {}
    for e in sorted(events, key=lambda e: (e["start"], e["channel_id"])):
        require(e["channel_id"] in channels, "Unknown channel")
        require(e["duration_min"] * 60 == (instant(e["stop"]) - instant(e["start"])).total_seconds(), "Wrong duration")
        require(e["has_art"] == (e["programme_id"] in ART_IDS), "Wrong art mapping")
        require(e["locale"] == channels[e["channel_id"]]["locale"], "Wrong locale")
        require(all(e[key] == PROGRAMMES[e["programme_id"]][key] for key in ("title", "synopsis", "genre")), "Programme identity changed")
        low, high = DURATION_RANGES[e["programme_id"]]
        require(low <= e["duration_min"] <= high,
                f"Implausible duration for {e['programme_id']}: {e['duration_min']} outside {low}–{high}")
        if e.get("subtitle"):
            owner = subtitle_owners.setdefault(e["subtitle"], e["programme_id"])
            require(owner == e["programme_id"], f"Subtitle belongs to multiple programmes: {e['subtitle']}")
        if "series" in e["genre"]:
            require(e.get("subtitle") and e.get("season", 0) > 0 and e.get("episode", 0) > 0, "Missing episode metadata")
            key = (e["programme_id"], e["season"], e["episode"])
            subtitle = episode_subtitles.setdefault(key, e["subtitle"])
            require(subtitle == e["subtitle"], f"Repeat changed its episode subtitle: {key}")
            titles = EPISODE_TITLES[e["programme_id"]]
            require(e["season"] == 1 and e["episode"] <= len(titles) and
                    e["subtitle"] == titles[e["episode"] - 1], "Episode does not match its catalogue")
            channel_key = (e["channel_id"], e["programme_id"], e["season"])
            seen = channel_episodes.setdefault(channel_key, set())
            require(e["episode"] in seen or e["episode"] == max(seen, default=0) + 1,
                    f"New episodes must increase in order: {channel_key}")
            seen.add(e["episode"])
        require("year" not in e, "Film metadata must be fictional and year-free")
        if channels[e["channel_id"]]["genre"] == "kids":
            a, b = instant(e["start"]).astimezone(TZ), instant(e["stop"]).astimezone(TZ)
            require(6 <= a.hour < 20 and b.hour <= 20 and 7 <= e["duration_min"] <= 25, "Kids outside operating hours/short lengths")
    by_id = {e["event_id"]: e for e in events}
    for dvr in fixture["dvr_fixtures"]:
        e = by_id[dvr["event_id"]]
        require(all(dvr[key] == e[key] for key in ("channel_id", "title")), "DVR reference mismatch")
        if dvr["state"] == "recording":
            require(instant(e["start"]) <= NOW < instant(e["stop"]), "Recording not active at snapshot")
        elif dvr["state"] == "scheduled":
            require(instant(e["start"]) > NOW, "Scheduled event already started")
        else:
            require(instant(e["stop"]) <= NOW, "Finished DVR event is in future")
        if "series_id" in dvr:
            require(dvr["series_id"] == e["programme_id"] and "episode" in e, "DVR series mismatch")
    conflicts = [by_id[d["event_id"]] for d in fixture["dvr_fixtures"] if d.get("conflict")]
    require(len(conflicts) == 2 and conflicts[0]["channel_id"] != conflicts[1]["channel_id"] and
            max(e["start"] for e in conflicts) < min(e["stop"] for e in conflicts), "Invalid conflict pair")
    # Assert the load-bearing layout stresses, not just basic JSON integrity.
    require(any(e["duration_min"] >= 420 and instant(e["start"]).astimezone(TZ).date() != instant(e["stop"]).astimezone(TZ).date() for e in events), "Missing overnight long event")
    require(any(e["programme_id"] == "sport-ridge-peloton" and e["duration_min"] >= 240 for e in events), "Missing endurance event")
    require(sum(40 <= len(p["title"]) <= 60 for p in PROGRAMMES.values()) >= 3, "Missing long titles")
    require(any(g["reason"] == "missing-guide-data" and instant(g["stop"]) - instant(g["start"]) == timedelta(hours=2) for g in gaps), "Missing two-hour gap")
    require(any(g["reason"] == "sparse-guide-ended" and instant(g["start"]) == START + timedelta(days=1) for g in gaps), "Missing sparse channel")
    for day in range(3):
        for channel in ("ch-northline-news", "ch-northline-world", "ch-city-desk"):
            for hour in range(24):
                require(any(e["channel_id"] == channel and 10 <= e["duration_min"] <= 15 and
                            instant(e["start"]) == START + timedelta(days=day, hours=hour)
                            for e in events), "Missing hourly bulletin")
            require(any(e["channel_id"] == channel and e["duration_min"] == 20 and
                        instant(e["start"]) == START + timedelta(days=day, hours=19, minutes=30)
                        for e in events), "Missing evening main news")
        for minute in (14, 58):
            require(any(e["channel_id"] == "ch-ion-frame" and instant(e["start"]).astimezone(TZ) == START + timedelta(days=day, hours=20 if minute == 14 else 21, minutes=minute) for e in events), "Missing off-grid evening")
        for minute in range(0, 30, 5):
            require(any(e["channel_id"] == "ch-skyglass-weather" and e["duration_min"] == 5 and instant(e["start"]).astimezone(TZ) == START + timedelta(days=day, hours=18, minutes=minute) for e in events), "Missing consecutive five-minute slots")
    return stats


def main():
    fixture = make_fixture()
    stats = validate(fixture)
    payload = (json.dumps(fixture, ensure_ascii=False, separators=(",", ":")) + "\n").encode()
    require(len(payload) < 1_500_000, f"Fixture exceeds size budget: {len(payload)}")
    # Validate before writing; serialise with fixed order, no wall-clock values.
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_bytes(payload)
    print("\n".join(stats))
    print(f"programmes={len({e['programme_id'] for e in fixture['events']})} art_programmes={len(ART_IDS)} "
          f"events={len(fixture['events'])} gaps={len(fixture['gaps'])} dvr={len(fixture['dvr_fixtures'])} bytes={len(payload)}")
    print(f"sha256={hashlib.sha256(payload).hexdigest()}")
    print(f"episode_catalogues={len(EPISODE_TITLES)} distinct_subtitles={len({e['subtitle'] for e in fixture['events'] if 'subtitle' in e})} "
          f"duration_contracts={len(DURATION_RANGES)} deliberate_loop_programmes={len(DELIBERATE_LOOPS)}")
    print("VALIDATION PASSED: 27 channels; complete declared coverage; no overlaps; DVR and realism checks passed")


if __name__ == "__main__":
    main()
