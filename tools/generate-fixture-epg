    headlines = "de-headlines" if german else "news-headlines"
    magazine = "de-magazine" if german else "news-field-desk"
    for h in range(24):
        s.add(15 if h % 2 == 0 else 12, hour)
        s.add(5 if h % 2 == 0 else 3, weather)
        if h == 19:
            s.add(15, magazine)
            s.add(20, "de-main" if german else "news-northline-tonight")
            s.add(5, weather)
            s.add(5, headlines)
