DELIBERATE_LOOPS = {"weather-loop", "news-skyglass-weather", "music-night", "music-day"}


def iso(value):
    return value.astimezone(timezone.utc).isoformat()


def instant(value):
    return datetime.fromisoformat(value)


def require(condition, message):
    if not condition:
        raise ValueError(message)


class Schedule:
    def __init__(self, channel, events, gaps, rng):
        self.channel, self.events, self.gaps, self.rng = channel, events, gaps, rng
        self.cursor = START
        self.episodes = Counter()

    def add(self, minutes, programme, subtitle=None):
        if self.cursor >= END:
            return
        stop = self.cursor + timedelta(minutes=minutes)
        require(stop <= END, f"Do not clip {programme} at the coverage boundary")
        p = PROGRAMMES[programme]
        event = dict(event_id=f"evt-{self.channel['channel_id']}-{self.cursor:%Y%m%dT%H%M}",
                     channel_id=self.channel['channel_id'], programme_id=programme,
                     **p, start=iso(self.cursor), stop=iso(stop),
                     duration_min=int((stop - self.cursor).total_seconds() // 60),
                     locale=self.channel['locale'], has_art=programme in ART_IDS)
        if "series" in p["genre"]:
            self.episodes[programme] += 1
            episode = self.episodes[programme]
            titles = EPISODE_TITLES[programme]
            require(subtitle is None, "Series subtitles must come from their episode catalogue")
            require(episode <= len(titles), f"Episode catalogue exhausted: {programme}")
            event.update(subtitle=titles[episode - 1], season=1, episode=episode)
        elif subtitle:
            event["subtitle"] = subtitle
        self.events.append(event)
        self.cursor = stop

    def block(self, rows):
        for minutes, programme in rows:
            self.add(minutes, programme)

    def gap(self, minutes, reason):
        stop = min(self.cursor + timedelta(minutes=minutes), END)
        if self.cursor < stop:
            self.gaps.append(dict(channel_id=self.channel["channel_id"], start=iso(self.cursor),
                                  stop=iso(stop), reason=reason))
            self.cursor = stop


def news(s, day):
    german = s.channel["locale"] == "de"
