            s.add(40 if h % 2 == 0 else 45, "de-review" if german else "news-review",
                  "Wiederholung der Abendgespräche" if german else "Evening interviews: repeat")
        elif h % 2 == 0:
            s.add(40, magazine if german else s.rng.choice([magazine, "news-bridges", "news-markets"]))
        else:
            s.add(15, magazine)
            s.add(5, headlines)
            s.add(25, magazine)


