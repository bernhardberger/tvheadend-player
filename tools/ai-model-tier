#!/usr/bin/env python3
"""Inspect or switch managed repository agents between standard and fast models."""

from __future__ import annotations

import argparse
import json
import os
import re
import stat
import sys
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
CONFIG_PATH = ROOT / ".opencode/opencode.json"
AGENT_MODELS = {
    "app-locator": "openai/gpt-5.6-luna",
    "app-explore": "openai/gpt-5.6-terra",
    "app-planner": "openai/gpt-5.6-sol",
    "app-analyze": "openai/gpt-5.6-sol",
    "app-research": "openai/gpt-5.6-sol",
    "android-reviewer": "openai/gpt-5.6-sol",
    "tv-ux-reviewer": "openai/gpt-5.6-sol",
}


def load_config(path: Path) -> dict[str, object]:
    try:
        config = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"cannot read {path}: {exc}") from exc
    if not isinstance(config, dict):
        raise ValueError(f"{path}: root must be a JSON object")
    return config


def configured_models(config: dict[str, object]) -> dict[str, str]:
    agents = config.get("agent")
    if not isinstance(agents, dict):
        raise ValueError("OpenCode config must contain an agent object")

    models: dict[str, str] = {}
    for name, standard_model in AGENT_MODELS.items():
        agent = agents.get(name)
        if not isinstance(agent, dict):
            raise ValueError(f"{name}: missing agent configuration")
        model = agent.get("model")
        allowed = {standard_model, f"{standard_model}-fast"}
        if model not in allowed:
            raise ValueError(
                f"{name}: unexpected model {model!r}; expected one of {sorted(allowed)}"
            )
        models[name] = model
    return models


def model_tier(config: dict[str, object]) -> str:
    models = configured_models(config)
    fast = {model.endswith("-fast") for model in models.values()}
    if fast == {True}:
        return "fast"
    if fast == {False}:
        return "standard"
    return "mixed"


def replace_model_lines(
    raw_config: str,
    current_models: dict[str, str],
    desired_models: dict[str, str],
) -> str:
    lines = raw_config.splitlines(keepends=True)
    for name in AGENT_MODELS:
        key_pattern = re.compile(rf'^(\s*)"{re.escape(name)}"\s*:\s*\{{\s*$')
        key_index = next(
            (index for index, line in enumerate(lines) if key_pattern.match(line.rstrip("\n"))),
            None,
        )
        if key_index is None:
            raise ValueError(f"{name}: cannot locate agent block in OpenCode config")

        key_indent = len(lines[key_index]) - len(lines[key_index].lstrip())
        model_index = None
        for index in range(key_index + 1, len(lines)):
            stripped = lines[index].lstrip()
            indent = len(lines[index]) - len(stripped)
            if indent <= key_indent:
                break
            if re.match(r'^"model"\s*:', stripped):
                model_index = index
                break
        if model_index is None:
            raise ValueError(f"{name}: cannot locate model field in OpenCode config")

        current = current_models[name]
        quoted_current = json.dumps(current)
        quoted_desired = json.dumps(desired_models[name])
        if quoted_current not in lines[model_index]:
            raise ValueError(f"{name}: parsed and textual model values do not match")
        lines[model_index] = lines[model_index].replace(
            quoted_current,
            quoted_desired,
            1,
        )
    return "".join(lines)


def atomic_write(path: Path, content: str) -> None:
    mode = stat.S_IMODE(path.stat().st_mode)
    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=path.parent,
            prefix=f".{path.name}.",
            delete=False,
        ) as temporary:
            temporary.write(content)
            temporary.flush()
            os.fsync(temporary.fileno())
            temporary_path = Path(temporary.name)
        temporary_path.chmod(mode)
        os.replace(temporary_path, path)
    finally:
        if temporary_path is not None and temporary_path.exists():
            temporary_path.unlink()


def switch_model_tier(path: Path, tier: str) -> bool:
    if tier not in {"fast", "standard"}:
        raise ValueError(f"unsupported model tier: {tier}")

    raw_config = path.read_text(encoding="utf-8")
    config = load_config(path)
    current_models = configured_models(config)
    suffix = "-fast" if tier == "fast" else ""
    desired_models = {
        name: f"{standard_model}{suffix}"
        for name, standard_model in AGENT_MODELS.items()
    }
    if current_models == desired_models:
        return False

    updated = replace_model_lines(raw_config, current_models, desired_models)
    atomic_write(path, updated)
    return True


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "tier",
        choices=("status", "fast", "standard"),
        help="show the current tier or select standard/priority-service models",
    )
    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        if args.tier == "status":
            config = load_config(CONFIG_PATH)
            tier = model_tier(config)
            print(f"managed-agent model tier: {tier}")
            for name, model in configured_models(config).items():
                print(f"{name}: {model}")
            if tier == "mixed":
                print(
                    "error: managed agents must all use the same service tier",
                    file=sys.stderr,
                )
                return 1
            return 0

        changed = switch_model_tier(CONFIG_PATH, args.tier)
    except (OSError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    state = "switched" if changed else "already configured"
    print(f"managed-agent model tier {state}: {args.tier}")
    print("Quit and restart OpenCode before using the new model assignments.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
