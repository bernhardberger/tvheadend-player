#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
ANDROID_HOME="${ANDROID_HOME:-/opt/android-sdk}"
APPLICATION_ID="at.bernhardberger.tvhplayer"
SDK_VERSION="0.31.0"
SDK_SOURCE_COMMIT="527785b1711b1245e15ac8ac7f9bd94264017244"
EVIDENCE_DIR="$ROOT_DIR/app/build/released-sdk-evidence"
NATIVE_SOURCE_NAME="ffmpeg-media3-1.11.1-sources.tar.xz"
SDK_SOURCE_NAME="tvheadend-sdk-${SDK_VERSION}-corresponding-source.tar.gz"
SDK_SOURCE_FILES=(
    "sdk-android-${SDK_VERSION}-sources.jar"
    "sdk-core-${SDK_VERSION}-sources.jar"
    "sdk-media3-${SDK_VERSION}-sources.jar"
    "sdk-playback-${SDK_VERSION}-sources.jar"
)

if [[ -n "$(git -C "$ROOT_DIR" status --porcelain --untracked-files=normal)" ]]; then
    printf 'error: release preparation requires a clean worktree\n' >&2
    exit 1
fi

apksigner=""
aapt=""
zipalign=""
for build_tools in "$ANDROID_HOME/build-tools/36.0.0" "$ANDROID_HOME/build-tools/35.0.0"; do
    if [[ -x "$build_tools/apksigner" && -x "$build_tools/aapt" && -x "$build_tools/zipalign" ]]; then
        apksigner="$build_tools/apksigner"
        aapt="$build_tools/aapt"
        zipalign="$build_tools/zipalign"
        break
    fi
done
if [[ -z "$apksigner" ]]; then
    printf 'error: apksigner, aapt, and zipalign are required in Android build-tools\n' >&2
    exit 1
fi

temporary_dir="$(mktemp -d)"
trap 'rm -rf "$temporary_dir"' EXIT

cd "$ROOT_DIR"
./tools/verify
# Release bytes are always built from scratch: a fresh JVM and no outputs restored from the build cache.
./gradlew clean :app:syncReleasedSdkEvidence :app:assemblePlayRelease :app:assembleApplianceRelease :app:bundlePlayRelease --no-daemon --no-build-cache

built_apk="app/build/outputs/apk/play/release/app-play-release-unsigned.apk"
built_appliance_apk="app/build/outputs/apk/appliance/release/app-appliance-release-unsigned.apk"
built_aab="app/build/outputs/bundle/playRelease/app-play-release.aab"
built_play_mapping="app/build/outputs/mapping/playRelease/mapping.txt"
built_appliance_mapping="app/build/outputs/mapping/applianceRelease/mapping.txt"
for artifact in "$built_apk" "$built_appliance_apk" "$built_aab"; do
    if [[ ! -f "$artifact" ]]; then
        printf 'error: expected release artifact was not produced: %s\n' "$artifact" >&2
        exit 1
    fi
done
for mapping in "$built_play_mapping" "$built_appliance_mapping"; do
    if [[ ! -f "$mapping" || ! -s "$mapping" || -L "$mapping" ]]; then
        printf 'error: release R8 mapping is missing, empty, or a symbolic link: %s\n' "$mapping" >&2
        exit 1
    fi
done
for apk in "$built_apk" "$built_appliance_apk"; do
    ./tools/check-native-libs --release --apk "$apk"
done

for source_file in "${SDK_SOURCE_FILES[@]}"; do
    if [[ ! -f "$EVIDENCE_DIR/$source_file" || -L "$EVIDENCE_DIR/$source_file" ]]; then
        printf 'error: released SDK corresponding-source file is missing: %s\n' "$source_file" >&2
        exit 1
    fi
done
tar \
    --sort=name \
    --mtime='@0' \
    --owner=0 \
    --group=0 \
    --numeric-owner \
    -C "$EVIDENCE_DIR" \
    -cf - \
    "${SDK_SOURCE_FILES[@]}" | gzip -n > "$temporary_dir/$SDK_SOURCE_NAME"
cp "$ROOT_DIR/decoder-ffmpeg/$NATIVE_SOURCE_NAME" "$temporary_dir/$NATIVE_SOURCE_NAME"

# Prove signing material is absent before and after alignment for both APKs.
for flavor in play appliance; do
    apk="app/build/outputs/apk/$flavor/release/app-$flavor-release-unsigned.apk"
    aligned="$temporary_dir/$flavor-unsigned.apk"
    python3 tools/release_metadata.py assert-unsigned-apk "$apk"
    "$zipalign" -f -P 16 4 "$apk" "$aligned"
    "$zipalign" -c -P 16 4 "$aligned"
    python3 tools/release_metadata.py assert-unsigned-apk "$aligned"
    python3 tools/release_metadata.py validate-apk-entry-points "$aligned" --flavor "$flavor" --aapt "$aapt"
done
aligned_apk="$temporary_dir/play-unsigned.apk"

badging="$($aapt dump badging "$aligned_apk")"
if [[ ! "$badging" =~ package:\ name=\'([^\']+)\' ]]; then
    printf 'error: unable to read APK application ID\n' >&2
    exit 1
fi
application_id="${BASH_REMATCH[1]}"
if [[ "$application_id" != "$APPLICATION_ID" ]]; then
    printf 'error: unexpected APK application ID: %s\n' "$application_id" >&2
    exit 1
fi
if [[ ! "$badging" =~ versionCode=\'([0-9]+)\' ]]; then
    printf 'error: unable to read APK versionCode\n' >&2
    exit 1
fi
version_code="${BASH_REMATCH[1]}"
if [[ ! "$badging" =~ versionName=\'([^\']+)\' ]]; then
    printf 'error: unable to read APK versionName\n' >&2
    exit 1
fi
version_name="${BASH_REMATCH[1]}"
appliance_badging="$($aapt dump badging "$temporary_dir/appliance-unsigned.apk")"
if [[ "$appliance_badging" != *"package: name='${APPLICATION_ID}.appliance' versionCode='$version_code' versionName='$version_name'"* ]]; then
    printf 'error: Appliance APK identity or version does not match the release\n' >&2
    exit 1
fi
python3 tools/release_metadata.py validate-aab \
    --aab "$built_aab" --play-apk "$aligned_apk" \
    --version-code "$version_code" --version-name "$version_name" --unsigned
printf 'AAB: native payload matches Play APK; 64-bit ELF LOAD alignment >=16 KB; bundletool confirms uncompressed PAGE_ALIGNMENT_16K generated APKs and Play identity.\n'

release_dir="${1:-$ROOT_DIR/build/release/unsigned/$version_name}"
if [[ -e "$release_dir" ]]; then
    printf 'error: release output already exists: %s\n' "$release_dir" >&2
    exit 1
fi
mkdir -p "$release_dir"

apk_name="tvheadend-player-${version_name}-play-unsigned.apk"
appliance_apk_name="tvheadend-player-${version_name}-appliance-unsigned.apk"
aab_name="tvheadend-player-${version_name}-play-unsigned.aab"
play_mapping_name="tvheadend-player-${version_name}-play-mapping.txt"
appliance_mapping_name="tvheadend-player-${version_name}-appliance-mapping.txt"
source_tar_name="tvheadend-player-${version_name}-source.tar.gz"
source_zip_name="tvheadend-player-${version_name}-source.zip"
cp "$aligned_apk" "$release_dir/$apk_name"
cp "$temporary_dir/appliance-unsigned.apk" "$release_dir/$appliance_apk_name"
cp "$built_aab" "$release_dir/$aab_name"
cp "$built_play_mapping" "$release_dir/$play_mapping_name"
cp "$built_appliance_mapping" "$release_dir/$appliance_mapping_name"
cp "$temporary_dir/$NATIVE_SOURCE_NAME" "$release_dir/$NATIVE_SOURCE_NAME"
cp "$temporary_dir/$SDK_SOURCE_NAME" "$release_dir/$SDK_SOURCE_NAME"
git archive --format=tar.gz --prefix="tvheadend-player-${version_name}/" \
    -o "$release_dir/$source_tar_name" HEAD
git archive --format=zip --prefix="tvheadend-player-${version_name}/" \
    -o "$release_dir/$source_zip_name" HEAD

python3 tools/release_metadata.py create-unsigned \
    --application-id "$application_id" \
    --version-code "$version_code" \
    --version-name "$version_name" \
    --source-commit "$(git rev-parse HEAD)" \
    --sdk-source-commit "$SDK_SOURCE_COMMIT" \
    --unsigned-play-apk "$release_dir/$apk_name" \
    --unsigned-appliance-apk "$release_dir/$appliance_apk_name" \
    --unsigned-play-aab "$release_dir/$aab_name" \
    --play-r8-mapping "$release_dir/$play_mapping_name" \
    --appliance-r8-mapping "$release_dir/$appliance_mapping_name" \
    --source-tar-gz "$release_dir/$source_tar_name" \
    --source-zip "$release_dir/$source_zip_name" \
    --native-source-tar-gz "$release_dir/$NATIVE_SOURCE_NAME" \
    --sdk-source-tar-gz "$release_dir/$SDK_SOURCE_NAME" \
    --output "$release_dir/release-manifest.json"
(
    cd "$release_dir"
    sha256sum \
        "$apk_name" \
        "$appliance_apk_name" \
        "$aab_name" \
        "$play_mapping_name" \
        "$appliance_mapping_name" \
        "$source_tar_name" \
        "$source_zip_name" \
        "$NATIVE_SOURCE_NAME" \
        "$SDK_SOURCE_NAME" \
        release-manifest.json > SHA256SUMS
)

printf 'Unsigned release bundle created at %s\n' "$release_dir"
