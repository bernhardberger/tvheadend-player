def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--serial",
        help="ADB device serial; overrides TVHPLAYER_ADB_SERIAL and local config",
    )
    parser.add_argument(
        "--target",
        help=(
            "Named local target; overrides TVHPLAYER_DEVICE_TARGET and "
            "active_target in local config"
        ),
    )
    parser.add_argument(
        "--package",
        dest="package_name",
        help=f"Android package name (default: {DEFAULT_PACKAGE})",
    )

    subparsers = parser.add_subparsers(dest="action", required=True)
    subparsers.add_parser("doctor", help="Check adb, authorization, model, SDK, and ABI")
    subparsers.add_parser("connect", help="Run adb connect for the configured serial")

    install_parser = subparsers.add_parser(
        "install-debug", help="Install or update the debug APK"
    )
    install_parser.add_argument(
        "--apk",
        type=Path,
        default=DEFAULT_APK,
        help=f"APK path (default: {DEFAULT_APK.relative_to(ROOT)})",
    )

    release_parser = subparsers.add_parser(
        "install-release",
        help="Install a verified signed release on an exact-identity deployment target",
    )
    release_parser.add_argument(
        "--bundle",
        type=Path,
        required=True,
        help="Signed release bundle produced by tools/release",
    )
    release_parser.add_argument(
        "--confirm-release-install",
        "--confirm-production-install",
        dest="confirm_release_install",
        action="store_true",
        help="Confirm explicit owner approval for this signed-release mutation",
    )

    uninstall_parser = subparsers.add_parser(
        "uninstall-legacy",
        help=f"Uninstall only the legacy production package {LEGACY_PACKAGE}",
    )
    uninstall_parser.add_argument(
        "--confirm-legacy-uninstall",
        action="store_true",
        help="Confirm explicit owner approval to remove the legacy rollback client",
    )

    subparsers.add_parser("launch", help="Launch the Leanback activity")
    subparsers.add_parser("force-stop", help="Force-stop the selected package")
    subparsers.add_parser("current", help="Show only the current/focused activity")
    subparsers.add_parser("package-info", help="Show bounded package metadata")
    subparsers.add_parser(
        "appliance-status",
        help="Show bounded accessibility binding and TCL auto-start state",
    )
    auto_start_parser = subparsers.add_parser(
        "allow-appliance-autostart",
        help="Allow TCL auto-start after the user enables the accessibility service",
    )
    auto_start_parser.add_argument(
        "--confirm-user-enabled-accessibility",
        action="store_true",
        help="Confirm that the user already enabled the scoped service in Android settings",
    )
    screenshot_parser = subparsers.add_parser(
        "screenshot",
        help="Capture a test-device screen to an owner-only ignored workspace PNG",
    )
    screenshot_parser.add_argument(
        "--output",
        type=Path,
        help="Exact PNG output path; defaults to ignored captures/device/<revision>/",
    )
    screenshot_parser.add_argument(
        "--name",
        default=DEFAULT_SCREENSHOT_NAME,
        help=f"Descriptive filename slug for default output (default: {DEFAULT_SCREENSHOT_NAME})",
    )
    screenshot_parser.add_argument(
        "--confirm-safe-screen",
        action="store_true",
        help="Confirm that no credential or other secret-bearing screen is visible",
    )
    screenshot_parser.add_argument(
        "--synthetic-video-backdrop",
        action="store_true",
        help="Temporarily show the debug build's synthetic player frame",
    )
    subparsers.add_parser("smoke", help="Force-stop, launch, and show current focus")
    subparsers.add_parser(
        "provision-test-credentials",
        help="Provision credentials from the configured local secret file into a debug app",
    )
    subparsers.add_parser(
        "accept-debug",
        help="Run bounded application acceptance on the exact configured G10 debug target",
    )

    key_parser = subparsers.add_parser("key", help="Send one approved named key event")
    key_parser.add_argument("name", choices=sorted(KEY_EVENTS))
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    target_name, config = load_local_config(
        args.target or os.environ.get("TVHPLAYER_DEVICE_TARGET")
    )

    adb = shutil.which("adb")
    if not adb:
        fail("adb is not available on PATH")

    serial = require_serial(
        args.serial or os.environ.get("TVHPLAYER_ADB_SERIAL") or config.get("serial")
    )
    package_name = (
        args.package_name
        or os.environ.get("TVHPLAYER_ANDROID_PACKAGE")
        or config.get("package")
        or DEFAULT_PACKAGE
    )
    role = config.get("role", "unclassified").strip().lower()
    if role not in VALID_ROLES:
        fail(
            f"invalid device role {role!r}; expected production, test, or unclassified"
        )

    if args.action == "accept-debug":
        static_policy_errors = acceptance_policy_errors(
            requested_target=args.target,
            selected_target=target_name,
            role=role,
            package_name=package_name,
            serial_overridden=(
                args.serial is not None or os.environ.get("TVHPLAYER_ADB_SERIAL") is not None
            ),
            package_overridden=(
                args.package_name is not None
                or os.environ.get("TVHPLAYER_ANDROID_PACKAGE") is not None
            ),
            config=config,
            properties=None,
        )
        if static_policy_errors:
            fail("; ".join(static_policy_errors))

    policy_error = action_policy_error(role, args.action)
    if policy_error:
        fail(policy_error)
    if args.action == "install-release" and not args.confirm_release_install:
        fail("install-release requires --confirm-release-install")
    if args.action == "uninstall-legacy" and not args.confirm_legacy_uninstall:
        fail("uninstall-legacy requires --confirm-legacy-uninstall")
    if args.action == "screenshot" and not args.confirm_safe_screen:
        fail("screenshot requires --confirm-safe-screen")
    if (
        args.action == "allow-appliance-autostart"
        and not args.confirm_user_enabled_accessibility
    ):
        fail(
            "allow-appliance-autostart requires "
            "--confirm-user-enabled-accessibility"
        )

    if args.action == "connect":
        run([adb, "connect", serial])
        return 0

    if args.action == "doctor":
        run([adb, "version"])
        require_device_ready(adb, serial)
        properties = read_device_properties(adb, serial)
        verify_configured_identity(properties, config, require_expected=False)
        print(f"device={serial}")
        if target_name:
            print(f"target={target_name}")
        print(f"role={role}")
        print(
            "manufacturer|model|device|product|android|abis="
            f"{properties['manufacturer']}|{properties['model']}|"
            f"{properties['device']}|{properties['product']}|"
            f"{properties['android']}|{properties['abis']}"
        )
        return 0

    if args.action == "accept-debug":
        properties = read_acceptance_device_properties(adb, serial)
        verify_configured_identity(properties, config, require_expected=True)
    elif args.action in TEST_DEVICE_ACTIONS | RELEASE_DEVICE_ACTIONS | PRODUCTION_DEVICE_ACTIONS:
        require_device_ready(adb, serial)
        properties = read_device_properties(adb, serial)
        verify_configured_identity(properties, config, require_expected=True)

    if args.action == "accept-debug":
        policy_errors = acceptance_policy_errors(
            requested_target=args.target,
            selected_target=target_name,
            role=role,
            package_name=package_name,
            serial_overridden=False,
            package_overridden=False,
            config=config,
            properties=properties,
        )
        if policy_errors:
            fail("; ".join(policy_errors))
        fixture = acceptance_fixture(config)
        for path, label in (
            (DEFAULT_APK, "debug app APK"),
            (DEFAULT_TEST_APK, "debug instrumentation APK"),
        ):
            if path.is_symlink() or not path.is_file():
                fail(f"{label} is missing; run ./tools/verify first")
        debuggable = run_bounded_redacted(
            adb_command(adb, serial, "shell", "run-as", DEFAULT_PACKAGE, "true"),
            timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS,
        )
        if debuggable is None or debuggable.returncode != 0:
            fail("accept-debug requires the installed app to be debuggable; cleanup was not attempted")

        revision = acceptance_revision()
        sdk_coordinate = released_sdk_coordinate()
        app_apk_sha256 = sha256_file(DEFAULT_APK)
        test_apk_sha256 = sha256_file(DEFAULT_TEST_APK)
        attestation_errors = acceptance_attestation_errors(
            load_acceptance_attestation(ACCEPTANCE_ATTESTATION),
            revision=revision,
            sdk_coordinate=sdk_coordinate,
            app_apk_sha256=app_apk_sha256,
            test_apk_sha256=test_apk_sha256,
        )
        if attestation_errors:
            fail("; ".join(attestation_errors))
        output = default_acceptance_output(revision)
        methods, cleanup = run_debug_acceptance(
            adb,
            serial,
            fixture,
            DEFAULT_APK,
            DEFAULT_TEST_APK,
        )
        write_acceptance_evidence(
            output,
            revision=revision,
            sdk_coordinate=sdk_coordinate,
            apk_sha256=app_apk_sha256,
            target={
                "name": "g10",
                "role": "test",
                **G10_IDENTITY,
            },
            methods=methods,
            cleanup=cleanup,
        )
        passed = methods and all(item["outcome"] == "PASS" for item in methods) and cleanup == "PASS"
        print(f"acceptanceEvidence={output}")
        print(f"acceptanceResult={'PASS' if passed else 'FAIL'}")
        if not passed:
            fail("debug acceptance failed; raw instrumentation output was discarded")
        return 0

    if args.action == "install-debug":
        apk = args.apk.expanduser().resolve()
        if not apk.is_file():
            fail(f"APK does not exist: {apk}")
        run(adb_command(adb, serial, "install", "-r", str(apk)))
        return 0

    if args.action == "install-release":
        if package_name != DEFAULT_PACKAGE:
            fail(f"release installation is available only for package {DEFAULT_PACKAGE}")
        apk = resolve_verified_release_apk(args.bundle)
        run(adb_command(adb, serial, "install", "-r", str(apk)))
        show_package_info(adb, serial, package_name)
        return 0

    if args.action == "uninstall-legacy":
        if not package_is_installed(adb, serial, DEFAULT_PACKAGE):
            fail(f"replacement package {DEFAULT_PACKAGE} is not installed")
        if not package_is_installed(adb, serial, LEGACY_PACKAGE):
            fail(f"legacy package {LEGACY_PACKAGE} is not installed")
        run(adb_command(adb, serial, "uninstall", LEGACY_PACKAGE))
        if package_is_installed(adb, serial, LEGACY_PACKAGE):
            fail(f"legacy package {LEGACY_PACKAGE} remains installed")
        print(f"removedPackage={LEGACY_PACKAGE}")
        return 0

    if args.action == "provision-test-credentials":
        if package_name != DEFAULT_PACKAGE:
            fail(
                "credential provisioning is available only for the debug "
                f"package {DEFAULT_PACKAGE}"
            )
        credential_path = Path(
            os.environ.get("TVHPLAYER_CREDENTIAL_FILE")
            or config.get("credential_file")
            or DEFAULT_CREDENTIAL_FILE
        ).expanduser()
        if not credential_path.is_absolute():
            credential_path = ROOT / credential_path
        payload = load_credential_payload(credential_path)

        run(adb_command(adb, serial, "shell", "am", "force-stop", package_name))
        run(
            adb_command(
                adb,
                serial,
                "exec-in",
                "run-as",
                package_name,
                "sh",
                "-c",
                "umask 077; mkdir -p files; "
                "rm -f files/tvhplayer_test_provisioning.result; "
                "cat > files/tvhplayer_test_provisioning.json",
            ),
            capture=True,
            input_data=payload,
            sensitive=True,
        )
        run(
            adb_command(
                adb,
                serial,
                "shell",
                "monkey",
                "-p",
                package_name,
                "-c",
                "android.intent.category.LEANBACK_LAUNCHER",
                "1",
            )
        )

        status_command = adb_command(
            adb,
            serial,
            "exec-out",
            "run-as",
            package_name,
            "sh",
            "-c",
            "if test -f files/tvhplayer_test_provisioning.result; then "
            "cat files/tvhplayer_test_provisioning.result; "
            "elif test -f files/tvhplayer_test_provisioning.json; then printf pending; "
            "else printf missing; fi",
        )
        deadline = time.monotonic() + 10
        status = "pending"
        while time.monotonic() < deadline and status == "pending":
            time.sleep(0.2)
            result = run(status_command, capture=True, check=False, announce=False)
            status = result.stdout.strip()
        run(
            adb_command(
                adb,
                serial,
                "shell",
                "run-as",
                package_name,
                "rm",
                "-f",
                "files/tvhplayer_test_provisioning.json",
                "files/tvhplayer_test_provisioning.result",
            ),
            capture=True,
            check=False,
            sensitive=True,
        )
        if status != "ok":
            fail("debug app did not accept the credential payload; no sensitive output shown")
        print("test-device credentials provisioned into app-private storage")
        return 0

    if args.action == "launch":
        run(
            adb_command(
                adb,
                serial,
                "shell",
                "monkey",
                "-p",
                package_name,
                "-c",
                "android.intent.category.LEANBACK_LAUNCHER",
                "1",
            )
        )
        return 0

    if args.action == "force-stop":
        run(adb_command(adb, serial, "shell", "am", "force-stop", package_name))
        return 0

    if args.action == "current":
        show_current_focus(adb, serial)
        return 0

    if args.action == "package-info":
        show_package_info(adb, serial, package_name)
        return 0

    if args.action == "appliance-status":
        show_appliance_status(adb, serial, package_name)
        return 0

    if args.action == "allow-appliance-autostart":
        if package_name != DEFAULT_PACKAGE:
            fail(f"auto-start repair is available only for package {DEFAULT_PACKAGE}")
        run(
            adb_command(
                adb,
                serial,
                "shell",
                "cmd",
                "appops",
                "set",
                package_name,
                "APP_AUTO_START",
                "allow",
            )
        )
        show_appliance_status(adb, serial, package_name)
        return 0

    if args.action == "screenshot":
        screenshot_output = args.output or default_screenshot_output(args.name)
        if args.synthetic_video_backdrop:
            try:
                set_debug_video_backdrop(
                    adb,
                    serial,
                    package_name,
                    visible=True,
                )
                time.sleep(0.5)
                capture_screenshot(adb, serial, screenshot_output)
            finally:
                set_debug_video_backdrop(
                    adb,
                    serial,
                    package_name,
                    visible=False,
                )
        else:
            capture_screenshot(adb, serial, screenshot_output)
        return 0

    if args.action == "key":
        run(
            adb_command(
                adb,
                serial,
                "shell",
                "input",
                "keyevent",
                KEY_EVENTS[args.name],
            )
        )
        return 0

    if args.action == "smoke":
        run(adb_command(adb, serial, "shell", "am", "force-stop", package_name))
        run(
            adb_command(
                adb,
                serial,
                "shell",
                "monkey",
                "-p",
                package_name,
                "-c",
                "android.intent.category.LEANBACK_LAUNCHER",
                "1",
            )
        )
        time.sleep(2)
        show_current_focus(adb, serial)
        return 0

    parser.error(f"unsupported action: {args.action}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
