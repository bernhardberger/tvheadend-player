class AcceptanceRunStopped(Exception):
    """Internal fail-closed control flow that still executes exact cleanup."""


def fail(message: str) -> NoReturn:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(2)


def normalize_device_config(value: object, *, label: str) -> dict[str, str]:
    if not isinstance(value, dict):
        fail(f"{label} must contain a JSON object")
    config: dict[str, str] = {}
    for key, item in value.items():
        if isinstance(item, (dict, list)):
            fail(f"{label} field {key!r} must be a scalar value")
        config[str(key)] = str(item)
    return config


def select_device_config(
    value: object,
    *,
    requested_target: str | None,
) -> tuple[str | None, dict[str, str]]:
    if not isinstance(value, dict):
        fail(f"{LOCAL_CONFIG} must contain a JSON object")

    if "targets" not in value:
        if requested_target:
            fail("named targets require a profiles-based .tvhplayer-device.json")
        return None, normalize_device_config(value, label=str(LOCAL_CONFIG))

    targets = value["targets"]
    if not isinstance(targets, dict):
        fail(f"{LOCAL_CONFIG} targets must contain a JSON object")

    target_name_value = requested_target or value.get("active_target")
    if not isinstance(target_name_value, str) or not target_name_value:
        fail(
            "device target is required; set active_target, "
            "TVHPLAYER_DEVICE_TARGET, or pass --target"
        )
    target_name = target_name_value.strip()
    if not TARGET_NAME_PATTERN.fullmatch(target_name):
        fail(
            "device target must use lowercase letters, digits, and hyphens "
            "and be at most 64 characters"
        )
    if target_name not in targets:
        fail(f"device target {target_name!r} is not configured")

    return target_name, normalize_device_config(
        targets[target_name],
        label=f"device target {target_name!r}",
    )


def load_local_config(
    requested_target: str | None,
) -> tuple[str | None, dict[str, str]]:
    if not LOCAL_CONFIG.exists():
        return select_device_config({}, requested_target=requested_target)
    try:
        value = json.loads(LOCAL_CONFIG.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read {LOCAL_CONFIG}: {exc}")
    return select_device_config(value, requested_target=requested_target)


def run(
    command: list[str],
    *,
    capture: bool = False,
    check: bool = True,
    input_data: str | None = None,
    sensitive: bool = False,
    announce: bool = True,
) -> subprocess.CompletedProcess[str]:
    if announce:
        suffix = " <redacted stdin>" if sensitive and input_data is not None else ""
        print(f"$ {shlex.join(command)}{suffix}", flush=True)
    result = subprocess.run(
        command,
        check=False,
        text=True,
        input=input_data,
        stdout=subprocess.PIPE if capture or sensitive else None,
        stderr=subprocess.PIPE if capture or sensitive else None,
    )
    if check and result.returncode != 0:
        if sensitive:
            fail("sensitive device operation failed; device output redacted")
        detail = (result.stderr or result.stdout or "").strip()
        fail(f"command failed with exit code {result.returncode}: {detail or 'no output'}")
    return result


def load_credential_payload(path: Path) -> str:
    try:
        if path.is_symlink() or not path.is_file():
            fail(f"credential file is missing or is not a regular file: {path}")
        file_stat = path.stat()
        if file_stat.st_uid != os.getuid():
            fail(f"credential file must be owned by the current user: {path}")
        mode = stat.S_IMODE(file_stat.st_mode)
        if mode & (stat.S_IRWXG | stat.S_IRWXO):
            fail(f"credential file must be accessible only by its owner: {path}")
        raw = path.read_bytes()
    except OSError as exc:
        fail(f"cannot read credential file {path}: {exc.strerror or 'I/O error'}")

    if len(raw) > MAX_CREDENTIAL_FILE_BYTES:
        fail(f"credential file exceeds {MAX_CREDENTIAL_FILE_BYTES} bytes")
    try:
        value = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail("credential file must contain valid UTF-8 JSON")
    if not isinstance(value, dict):
        fail("credential file must contain a JSON object")

    host = value.get("host")
    username = value.get("username")
    password = value.get("password")
    port = value.get("htsp_port", 9982)
    auto_connect = value.get("auto_connect", True)
    if not isinstance(host, str) or not host.strip() or "\n" in host or "\r" in host:
        fail("credential file host must be a non-empty single-line string")
    if not isinstance(username, str) or not username.strip() or "\n" in username or "\r" in username:
        fail("credential file username must be a non-empty single-line string")
    if not isinstance(password, str) or not password:
        fail("credential file password must be a non-empty string")
    if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
        fail("credential file htsp_port must be an integer from 1 through 65535")
    if not isinstance(auto_connect, bool):
        fail("credential file auto_connect must be true or false")

    # Canonicalize the accepted fields so unrelated local data is never staged.
    return json.dumps(
        {
            "host": host.strip(),
            "htsp_port": port,
            "username": username.strip(),
            "password": password,
            "auto_connect": auto_connect,
        },
        separators=(",", ":"),
    )


def adb_command(adb: str, serial: str, *arguments: str) -> list[str]:
    return [adb, "-s", serial, *arguments]


def require_serial(value: str | None) -> str:
    if not value or value == "replace-with-adb-serial":
        fail(
            "ADB serial is required; set TVHPLAYER_ADB_SERIAL, pass --serial, "
            "or create ignored .tvhplayer-device.json"
        )
    if any(character.isspace() for character in value):
        fail("ADB serial must not contain whitespace")
    return value


def action_policy_error(role: str, action: str) -> str | None:
    if action in RELEASE_DEVICE_ACTIONS:
        if role in {"production", "test"}:
            return None
        return f"{action} requires an explicitly classified deployment target"
    if action in PRODUCTION_DEVICE_ACTIONS:
        if role == "production":
            return None
        return f"{action} requires an explicitly classified production device"
    if action not in TEST_DEVICE_ACTIONS:
        return None
    if role == "test":
        return None
    if role == "production":
        return (
            f"{action} is blocked for a production device; configure a separate "
            "device with role 'test'"
        )
    return (
        f"{action} requires an explicitly classified test device; set role to "
        "'test' in ignored .tvhplayer-device.json"
    )


def identity_errors(
    *,
    actual_manufacturer: str,
    actual_model: str,
    actual_device: str,
    actual_product: str,
    expected_manufacturer: str | None,
    expected_model: str | None,
    expected_device: str | None,
    expected_product: str | None,
    require_expected: bool,
) -> list[str]:
    errors: list[str] = []

    def configured_value(value: str | None) -> str | None:
        normalized = value.strip() if value else None
        if normalized and normalized.casefold().startswith("replace-"):
            return None
        return normalized

    expected_manufacturer = configured_value(expected_manufacturer)
    expected_model = configured_value(expected_model)
    expected_device = configured_value(expected_device)
    expected_product = configured_value(expected_product)

    if require_expected and not expected_manufacturer:
        errors.append("expected_manufacturer is required for restricted test-device actions")
    if require_expected and not expected_model:
        errors.append("expected_model is required for restricted test-device actions")
    if require_expected and not expected_device:
        errors.append("expected_device is required for restricted test-device actions")
    if require_expected and not expected_product:
        errors.append("expected_product is required for restricted test-device actions")

    if expected_manufacturer and actual_manufacturer.casefold() != expected_manufacturer.casefold():
        errors.append(
            f"device manufacturer {actual_manufacturer!r} does not match "
            f"expected {expected_manufacturer!r}"
        )
    if expected_model and actual_model.casefold() != expected_model.casefold():
        errors.append(
            f"device model {actual_model!r} does not match expected {expected_model!r}"
        )
    if expected_device and actual_device.casefold() != expected_device.casefold():
        errors.append(
            f"device code {actual_device!r} does not match expected {expected_device!r}"
        )
    if expected_product and actual_product.casefold() != expected_product.casefold():
        errors.append(
            f"device product {actual_product!r} does not match expected {expected_product!r}"
        )
    return errors


def acceptance_policy_errors(
    *,
    requested_target: str | None,
    selected_target: str | None,
    role: str,
    package_name: str,
    serial_overridden: bool,
    package_overridden: bool,
    config: dict[str, str],
    properties: dict[str, str] | None,
) -> list[str]:
    errors: list[str] = []
    if requested_target != "g10" or selected_target != "g10":
        errors.append("accept-debug requires the explicit named target --target g10")
    if role != "test":
        errors.append("accept-debug requires target g10 to have role 'test'")
    if package_name != DEFAULT_PACKAGE:
        errors.append(f"accept-debug is available only for package {DEFAULT_PACKAGE}")
    if serial_overridden or package_overridden:
        errors.append("accept-debug rejects serial and package identity overrides")
    for field, expected in G10_IDENTITY.items():
        configured = config.get(f"expected_{field}")
        if configured != expected:
            errors.append(f"accept-debug requires expected_{field}={expected!r}")
        if properties is not None and properties.get(field) != expected:
            errors.append(f"accept-debug rejected live {field} identity")
    return errors


def acceptance_fixture(config: dict[str, str]) -> dict[str, str]:
    fixture: dict[str, str] = {}
    for config_name, argument_name in (
        ("acceptance_progressive_channel_id", "progressiveChannelId"),
        ("acceptance_interlaced_channel_id", "interlacedChannelId"),
    ):
        raw = config.get(config_name, "")
        value = raw.strip()
        if not value.isascii() or not value.isdigit() or int(value) <= 0:
            fail(f"{config_name} must be a positive decimal channel ID")
        fixture[argument_name] = str(int(value))
    if fixture["progressiveChannelId"] == fixture["interlacedChannelId"]:
        fail("progressive and interlaced acceptance channel IDs must differ")
    return fixture


def acceptance_instrumentation_command(
    adb: str,
    serial: str,
    method: str,
    fixture: dict[str, str],
) -> list[str]:
    if method not in ACCEPTANCE_METHODS:
        fail("acceptance instrumentation method is not approved")
    command = adb_command(adb, serial, "shell", "am", "instrument", "-w", "-r")
    for name in ("progressiveChannelId", "interlacedChannelId"):
        command.extend(("-e", name, fixture[name]))
    command.extend(("-e", "class", f"{ACCEPTANCE_TEST_CLASS}#{method}", TEST_RUNNER))
    return command


def acceptance_instrumentation_outcome(
    result: subprocess.CompletedProcess[str],
) -> str:
    output = result.stdout or ""
    passed = (
        result.returncode == 0
        and "OK (1 test)" in output
        and "INSTRUMENTATION_CODE: -1" in output
        and "FAILURES!!!" not in output
        and "INSTRUMENTATION_FAILED" not in output
    )
    return "PASS" if passed else "FAIL"


def package_query_command(adb: str, serial: str) -> list[str]:
    return adb_command(
        adb,
        serial,
        "shell",
        "pm",
        "list",
        "packages",
        "--user",
        "0",
        TEST_PACKAGE,
    )


def package_query_outcome(result: subprocess.CompletedProcess[str]) -> str:
    if result.returncode != 0:
        return "INVALID"
    if result.stdout == "":
        return "ABSENT"
    if (result.stdout or "").splitlines() == [f"package:{TEST_PACKAGE}"]:
        return "PRESENT"
    return "INVALID"


def package_mutation_succeeded(result: subprocess.CompletedProcess[str] | None) -> bool:
    return result is not None and result.returncode == 0 and any(
        line.strip() == "Success" for line in (result.stdout or "").splitlines()
    )


def run_bounded_redacted(
    command: list[str],
    *,
    timeout_seconds: int,
) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(
            command,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired:
        return None


def parse_device_properties(output: str) -> dict[str, str] | None:
    values = output.splitlines()
    if len(values) != len(DEVICE_PROPERTIES):
        return None
    return dict(zip(DEVICE_PROPERTIES, values, strict=True))


def read_acceptance_device_properties(adb: str, serial: str) -> dict[str, str]:
    state = run_bounded_redacted(
        adb_command(adb, serial, "get-state"),
        timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS,
    )
    if state is None or state.returncode != 0 or state.stdout.strip() != "device":
        fail("configured G10 is not ready; device output was redacted")
    result = run_bounded_redacted(
        adb_command(
            adb,
            serial,
            "shell",
            "for property in "
            + " ".join(DEVICE_PROPERTIES.values())
            + '; do getprop "$property"; done',
        ),
        timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS,
    )
    properties = None if result is None else parse_device_properties(result.stdout)
    if result is None or result.returncode != 0 or properties is None:
        fail("configured G10 returned invalid identity; device output was redacted")
    return properties


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def load_acceptance_attestation(path: Path) -> dict[str, object]:
    try:
        if path.is_symlink() or not path.is_file():
            fail("device-acceptance build attestation is missing; run ./tools/verify from clean HEAD")
        file_stat = path.stat()
        if file_stat.st_uid != os.getuid() or stat.S_IMODE(file_stat.st_mode) & (stat.S_IRWXG | stat.S_IRWXO):
            fail("device-acceptance build attestation must be owner-only")
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        fail("device-acceptance build attestation is unreadable")
    if not isinstance(value, dict):
        fail("device-acceptance build attestation is invalid")
    return value


def acceptance_attestation_errors(
    attestation: dict[str, object],
    *,
    revision: str,
    sdk_coordinate: str,
    app_apk_sha256: str,
    test_apk_sha256: str,
) -> list[str]:
    expected = {
        "schemaVersion": 1,
        "appCommit": revision,
        "sdkCoordinate": sdk_coordinate,
        "appApkSha256": app_apk_sha256,
        "testApkSha256": test_apk_sha256,
    }
    errors: list[str] = []
    if set(attestation) != set(expected):
        errors.append("device-acceptance build attestation fields do not match")
    for name, value in expected.items():
        if attestation.get(name) != value:
            errors.append(f"device-acceptance build attestation {name} does not match")
    return errors


def acceptance_revision() -> str:
    revision = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=ROOT,
        check=False,
        capture_output=True,
        text=True,
    )
    status = subprocess.run(
        ["git", "status", "--porcelain", "--untracked-files=normal"],
        cwd=ROOT,
        check=False,
        capture_output=True,
        text=True,
    )
    if revision.returncode != 0 or status.returncode != 0 or not revision.stdout.strip():
        fail("cannot establish the app revision for device acceptance")
    if status.stdout.strip():
        fail("accept-debug requires a clean app worktree")
    return revision.stdout.strip()


def released_sdk_coordinate() -> str:
    try:
        with (ROOT / "gradle/libs.versions.toml").open("rb") as stream:
            version = tomllib.load(stream)["versions"]["tvheadend-sdk"]
    except (OSError, KeyError, TypeError, tomllib.TOMLDecodeError):
        fail("cannot read the released SDK coordinate")
    if not isinstance(version, str) or not re.fullmatch(r"\d+\.\d+\.\d+", version):
        fail("released SDK version is invalid")
    return f"at.bernhardberger.tvheadend:sdk-media3:{version}"


def default_acceptance_output(
    revision: str,
    *,
    now: datetime | None = None,
) -> Path:
    timestamp = (now or datetime.now(timezone.utc)).astimezone(timezone.utc)
    return (
        ACCEPTANCE_ROOT
        / revision[:12]
        / f"{timestamp.strftime('%Y%m%dT%H%M%SZ')}-debug-acceptance.json"
    )


def write_acceptance_evidence(
    output: Path,
    *,
    revision: str,
    sdk_coordinate: str,
    apk_sha256: str,
    target: dict[str, str],
    methods: list[dict[str, object]],
    cleanup: str,
) -> None:
    result = "PASS" if methods and all(item["outcome"] == "PASS" for item in methods) and cleanup == "PASS" else "FAIL"
    evidence = {
        "schemaVersion": 1,
        "appCommit": revision,
        "sdkCoordinate": sdk_coordinate,
        "apkSha256": apk_sha256,
        "target": target,
        "methods": methods,
        "cleanup": cleanup,
        "result": result,
    }
    output.parent.mkdir(mode=stat.S_IRWXU, parents=True, exist_ok=True)
    directories = [output.parent]
    if output == ACCEPTANCE_ROOT or ACCEPTANCE_ROOT in output.parents:
        directories.extend((CAPTURE_ROOT, ACCEPTANCE_ROOT))
    for directory in directories:
        os.chmod(directory, stat.S_IRWXU)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{output.name}.", dir=output.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, stat.S_IRUSR | stat.S_IWUSR)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(evidence, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
        os.replace(temporary, output)
        os.chmod(output, stat.S_IRUSR | stat.S_IWUSR)
    except OSError as exc:
        fail(f"cannot write device-acceptance evidence: {exc.strerror or 'I/O error'}")
    finally:
        temporary.unlink(missing_ok=True)


def run_debug_acceptance(
    adb: str,
    serial: str,
    fixture: dict[str, str],
    app_apk: Path,
    test_apk: Path,
) -> tuple[list[dict[str, object]], str]:
    methods: list[dict[str, object]] = []
    cleanup = "FAIL"
    try:
        app_install_started = time.monotonic()
        app_installed = run_bounded_redacted(
            adb_command(adb, serial, "install", "-r", str(app_apk)),
            timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS,
        )
        app_install_duration = max(0, round((time.monotonic() - app_install_started) * 1000))
        if not package_mutation_succeeded(app_installed):
            methods.append({
                "name": "installAppUnderTest",
                "outcome": "TIMEOUT" if app_installed is None else "FAIL",
                "durationMs": app_install_duration,
            })
            raise AcceptanceRunStopped
        installed_debuggable = run_bounded_redacted(
            adb_command(adb, serial, "shell", "run-as", DEFAULT_PACKAGE, "true"),
            timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS,
        )
        if installed_debuggable is None or installed_debuggable.returncode != 0:
            methods.append({
                "name": "installAppUnderTest",
                "outcome": "FAIL",
                "durationMs": app_install_duration,
            })
            raise AcceptanceRunStopped

        preparation_started = time.monotonic()
        stale_test = run_bounded_redacted(
            package_query_command(adb, serial),
            timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS,
        )
        stale_test_outcome = (
            "INVALID" if stale_test is None else package_query_outcome(stale_test)
        )
        if stale_test_outcome == "INVALID":
            methods.append({
                "name": "prepareInstrumentation",
                "outcome": "TIMEOUT" if stale_test is None else "FAIL",
                "durationMs": max(0, round((time.monotonic() - preparation_started) * 1000)),
            })
            raise AcceptanceRunStopped
        if stale_test_outcome == "PRESENT":
            removed = run_bounded_redacted(
                adb_command(adb, serial, "uninstall", TEST_PACKAGE),
                timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS,
            )
            if not package_mutation_succeeded(removed):
                methods.append({
                    "name": "prepareInstrumentation",
                    "outcome": "TIMEOUT" if removed is None else "FAIL",
                    "durationMs": max(0, round((time.monotonic() - preparation_started) * 1000)),
                })
                raise AcceptanceRunStopped

        install_started = time.monotonic()
        installed = run_bounded_redacted(
            adb_command(adb, serial, "install", "-r", str(test_apk)),
            timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS,
        )
        install_duration = max(0, round((time.monotonic() - install_started) * 1000))
        if not package_mutation_succeeded(installed):
            methods.append({
                "name": "installInstrumentation",
                "outcome": "TIMEOUT" if installed is None else "FAIL",
                "durationMs": install_duration,
            })
            raise AcceptanceRunStopped

        for method in ACCEPTANCE_METHODS:
            started = time.monotonic()
            result = run_bounded_redacted(
                acceptance_instrumentation_command(adb, serial, method, fixture),
                timeout_seconds=ACCEPTANCE_METHOD_TIMEOUT_SECONDS,
            )
            duration_ms = max(0, round((time.monotonic() - started) * 1000))
            outcome = "TIMEOUT" if result is None else acceptance_instrumentation_outcome(result)
            methods.append({"name": method, "outcome": outcome, "durationMs": duration_ms})
            if outcome != "PASS":
                break
    except AcceptanceRunStopped:
        pass
    finally:
        force_stop_commands = (
            adb_command(adb, serial, "shell", "am", "force-stop", DEFAULT_PACKAGE),
            adb_command(adb, serial, "shell", "am", "force-stop", TEST_PACKAGE),
        )
        force_stop_results = [
            run_bounded_redacted(command, timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS)
            for command in force_stop_commands
        ]
        installed_before_cleanup = run_bounded_redacted(
            package_query_command(adb, serial),
            timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS,
        )
        installed_before_cleanup_outcome = (
            "INVALID"
            if installed_before_cleanup is None
            else package_query_outcome(installed_before_cleanup)
        )
        if installed_before_cleanup_outcome == "PRESENT":
            removed = run_bounded_redacted(
                adb_command(adb, serial, "uninstall", TEST_PACKAGE),
                timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS,
            )
            removal_succeeded = package_mutation_succeeded(removed)
        else:
            removal_succeeded = installed_before_cleanup_outcome == "ABSENT"
        absent = run_bounded_redacted(
            package_query_command(adb, serial),
            timeout_seconds=ACCEPTANCE_ADB_TIMEOUT_SECONDS,
        )
        cleanup = "PASS" if (
            all(
                result is not None and result.returncode == 0
                for result in force_stop_results
            )
            and removal_succeeded
            and absent is not None
            and package_query_outcome(absent) == "ABSENT"
        ) else "FAIL"
    return methods, cleanup


def require_device_ready(adb: str, serial: str) -> None:
    state = run(adb_command(adb, serial, "get-state"), capture=True, check=False)
    if state.returncode != 0 or state.stdout.strip() != "device":
        detail = (state.stderr or state.stdout).strip()
        fail(f"device {serial} is not ready: {detail or 'unknown adb state'}")


def read_device_properties(adb: str, serial: str) -> dict[str, str]:
    result = run(
        adb_command(
            adb,
            serial,
            "shell",
            "for property in "
            + " ".join(DEVICE_PROPERTIES.values())
            + '; do getprop "$property"; done',
        ),
        capture=True,
    )
    properties = parse_device_properties(result.stdout)
    if properties is None:
        fail("device returned an unexpected property response")
    return properties


def verify_configured_identity(
    properties: dict[str, str],
    config: dict[str, str],
    *,
    require_expected: bool,
) -> None:
    errors = identity_errors(
        actual_manufacturer=properties["manufacturer"],
        actual_model=properties["model"],
        actual_device=properties["device"],
        actual_product=properties["product"],
        expected_manufacturer=config.get("expected_manufacturer"),
        expected_model=config.get("expected_model"),
        expected_device=config.get("expected_device"),
        expected_product=config.get("expected_product"),
        require_expected=require_expected,
    )
    if errors:
        fail("; ".join(errors))


def show_current_focus(adb: str, serial: str) -> None:
    result = run(
        adb_command(adb, serial, "shell", "dumpsys", "window"),
        capture=True,
    )
    lines = [
        line.strip()
        for line in result.stdout.splitlines()
        if "mCurrentFocus=" in line or "mFocusedApp=" in line
    ]
    if not lines:
        fail("Android window service did not report a focused activity")
    print("\n".join(lines))


def show_package_info(adb: str, serial: str, package_name: str) -> None:
    result = run(
        adb_command(adb, serial, "shell", "dumpsys", "package", package_name),
        capture=True,
    )
    prefixes = (
        "versionCode=",
        "versionName=",
        "firstInstallTime=",
        "lastUpdateTime=",
        "primaryCpuAbi=",
        "secondaryCpuAbi=",
    )
    lines = [
        line.strip()
        for line in result.stdout.splitlines()
        if line.strip().startswith(prefixes)
    ]
    if not lines:
        fail(f"package {package_name} was not found or returned no bounded metadata")
    print("\n".join(dict.fromkeys(lines)))


def show_appliance_status(adb: str, serial: str, package_name: str) -> None:
    service_class = f"{package_name}.accessibility.ApplianceEntryAccessibilityService"
    component = f"{package_name}/{service_class}"

    accessibility_enabled = run(
        adb_command(
            adb,
            serial,
            "shell",
            "settings",
            "get",
            "secure",
            "accessibility_enabled",
        ),
        capture=True,
    ).stdout.strip()
    enabled_services = run(
        adb_command(
            adb,
            serial,
            "shell",
            "settings",
            "get",
            "secure",
            "enabled_accessibility_services",
        ),
        capture=True,
    ).stdout.strip()
    service_state = run(
        adb_command(
            adb,
            serial,
            "shell",
            "dumpsys",
            "activity",
            "services",
            component,
        ),
        capture=True,
    ).stdout
    app_op = run(
        adb_command(
            adb,
            serial,
            "shell",
            "cmd",
            "appops",
            "get",
            package_name,
            "APP_AUTO_START",
        ),
        capture=True,
        check=False,
    )

    enabled_components = set(enabled_services.split(":"))
    auto_start = "unsupported" if app_op.returncode != 0 else "default"
    for line in app_op.stdout.splitlines():
        name, separator, value = line.strip().partition(":")
        if separator and name in {"AUTO_START", "APP_AUTO_START"}:
            auto_start = value.strip().split(maxsplit=1)[0].rstrip(";")
            break

    print(f"accessibilityEnabled={str(accessibility_enabled == '1').lower()}")
    print(f"serviceEnabled={str(component in enabled_components).lower()}")
    print(f"serviceBound={str(component in service_state).lower()}")
    print(f"autoStart={auto_start}")


def package_is_installed(adb: str, serial: str, package_name: str) -> bool:
    result = run(
        adb_command(adb, serial, "shell", "pm", "path", package_name),
        capture=True,
        check=False,
    )
    return result.returncode == 0 and any(
        line.startswith("package:") for line in result.stdout.splitlines()
    )


def resolve_verified_release_apk(bundle: Path) -> Path:
    bundle = bundle.expanduser().resolve()
    subprocess.run(
        [str(RELEASE_TOOL), "verify-signed", str(bundle)],
        check=True,
    )
    try:
        manifest = json.loads((bundle / "release-manifest.json").read_text(encoding="utf-8"))
        if manifest.get("applicationId") != DEFAULT_PACKAGE:
            fail(f"release bundle is not for {DEFAULT_PACKAGE}")
        apk_name = manifest["artifacts"]["signedApk"]["file"]
        if not isinstance(apk_name, str) or Path(apk_name).name != apk_name:
            fail("release bundle has an invalid signed APK path")
        apk = bundle / apk_name
        if apk.is_symlink() or not apk.is_file():
            fail("verified signed APK is missing or is not a regular file")
        return apk
    except (OSError, json.JSONDecodeError, KeyError, TypeError, AttributeError) as exc:
        fail(f"cannot read verified release manifest: {exc}")


def sanitize_screenshot_name(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", value.strip().lower()).strip("-")
    return slug[:80].rstrip("-") or DEFAULT_SCREENSHOT_NAME


def screenshot_revision() -> tuple[str, bool]:
    head = subprocess.run(
        ["git", "rev-parse", "--short=12", "HEAD"],
        cwd=ROOT,
        check=False,
        capture_output=True,
        text=True,
    )
    if head.returncode != 0 or not head.stdout.strip():
        fail("cannot determine the current Git revision for screenshot output")
    status = subprocess.run(
        ["git", "status", "--porcelain", "--untracked-files=normal"],
        cwd=ROOT,
        check=False,
        capture_output=True,
        text=True,
    )
    if status.returncode != 0:
        fail("cannot determine the working-tree state for screenshot output")
    return head.stdout.strip(), bool(status.stdout.strip())


def default_screenshot_output(
    name: str,
    *,
    revision: str | None = None,
    dirty: bool | None = None,
    now: datetime | None = None,
) -> Path:
    if revision is None or dirty is None:
        detected_revision, detected_dirty = screenshot_revision()
        revision = revision or detected_revision
        dirty = detected_dirty if dirty is None else dirty
    revision_directory = f"{revision}-dirty" if dirty else revision
    timestamp = (now or datetime.now(timezone.utc)).astimezone(timezone.utc)
    filename = f"{timestamp.strftime('%Y%m%dT%H%M%SZ')}-{sanitize_screenshot_name(name)}.png"
    return CAPTURE_ROOT / revision_directory / filename


def resolve_screenshot_output(path: Path) -> Path:
    if path.suffix.lower() != ".png":
        fail("screenshot output must use a .png extension")
    try:
        output = path.expanduser().resolve()
    except OSError as exc:
        fail(f"cannot resolve screenshot output {path}: {exc.strerror or 'I/O error'}")
    in_repository = output == ROOT or ROOT in output.parents
    in_capture_tree = output == CAPTURE_ROOT or CAPTURE_ROOT in output.parents
    if in_repository and not in_capture_tree:
        fail("repository screenshot output must be under captures/device")
    if in_capture_tree:
        output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        for directory in (ROOT / "captures", CAPTURE_ROOT, output.parent):
            os.chmod(directory, stat.S_IRWXU)
    elif not output.parent.is_dir():
        fail(f"screenshot output directory does not exist: {output.parent}")
    if output.is_symlink() or (output.exists() and not output.is_file()):
        fail(f"screenshot output must be a regular file path: {output}")
    return output


def capture_screenshot(adb: str, serial: str, output_path: Path) -> None:
    output = resolve_screenshot_output(output_path)
    command = adb_command(adb, serial, "exec-out", "screencap", "-p")
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{output.name}.",
        dir=output.parent,
    )
    temporary = Path(temporary_name)
    try:
        os.chmod(temporary, stat.S_IRUSR | stat.S_IWUSR)
        print(f"$ {shlex.join(command)} > {shlex.quote(str(output))}", flush=True)
        with os.fdopen(descriptor, "wb") as stream:
            result = subprocess.run(
                command,
                check=False,
                stdout=stream,
                stderr=subprocess.PIPE,
            )
        if result.returncode != 0:
            detail = result.stderr.decode("utf-8", errors="replace").strip()
            fail(
                "screenshot capture failed with exit code "
                f"{result.returncode}: {detail or 'no output'}"
            )
        with temporary.open("rb") as stream:
            if stream.read(len(PNG_SIGNATURE)) != PNG_SIGNATURE:
                fail("device screenshot did not return a valid PNG")
        os.replace(temporary, output)
        os.chmod(output, stat.S_IRUSR | stat.S_IWUSR)
    except OSError as exc:
        fail(f"cannot write screenshot {output}: {exc.strerror or 'I/O error'}")
    finally:
        temporary.unlink(missing_ok=True)
    print(f"screenshot={output}")


