#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

# --staged-sdk builds against the SDK checkout staged in ../tvheadend-sdk/build/local-maven so an
# SDK fix can be tested before it is published. Such a run cannot prove public SDK consumption, so
# it drops only SDK provenance and reports a weaker conclusion. It never gates a release.
# Routine verification covers both independent applications and their manifest contracts.
# --release also builds the unsigned, minified companion release APK.
staged_sdk=false
capture_tests=exclude
release_checks=false
for argument in "$@"; do
    case "$argument" in
        --staged-sdk) staged_sdk=true ;;
        --visual-captures) capture_tests=all ;;
        --release) release_checks=true ;;
        *)
            printf 'error: unknown option: %s\n' "$argument" >&2
            printf 'usage: tools/verify [--staged-sdk] [--visual-captures] [--release]\n' >&2
            exit 1
            ;;
    esac
done

# The shared integration host installs this launcher. Other developer hosts keep
# the ordinary local path. Never silently fall back when the installed runner fails.
if [[ -x /usr/local/bin/tvhplayer-verify && "${TVHPLAYER_VERIFY_ISOLATED:-}" != 1 ]]; then
    exec /usr/local/bin/tvhplayer-verify "$ROOT_DIR" "$@"
fi

gradle_arguments=()
if [[ "${TVHPLAYER_VERIFY_ISOLATED:-}" == 1 ]]; then
    # Reusing a daemon outside the unit would bypass its budget and cancellation.
    gradle_arguments+=(--no-daemon --max-workers=2 -Pkotlin.compiler.execution.strategy=in-process)
fi
provenance_tasks=(:app:verifyExternalSdkConsumption)
appliance_tasks=(:appliance:lintDebug :appliance:assembleDebug)
if [[ "$release_checks" == true ]]; then
    appliance_tasks+=(:appliance:assembleRelease)
fi
if [[ "$staged_sdk" == true ]]; then
    gradle_arguments+=(-Ptvheadend.sdk.local=true)
    provenance_tasks=()
    printf '==> WARNING: building against the staged SDK\n'
    printf '    This is a development build. It is not release-verified, must not be signed or\n'
    printf '    published, and must not be installed on a production device.\n'
    printf '    Public SDK provenance is skipped; app-owned native/source proof remains required.\n'
fi

export ANDROID_HOME="${ANDROID_HOME:-/opt/android-sdk}"
export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"

if ! command -v java >/dev/null 2>&1; then
    printf 'error: Java is not available on PATH\n' >&2
    exit 1
fi

java_version="$(java -version 2>&1 | { IFS= read -r line; printf '%s' "$line"; })"
if [[ ! "$java_version" =~ version\ \"([0-9]+) ]]; then
    printf 'error: unable to parse Java version from: %s\n' "$java_version" >&2
    exit 1
fi
if (( BASH_REMATCH[1] < 21 )); then
    printf 'error: Java 21 or newer is required; found: %s\n' "$java_version" >&2
    exit 1
fi

if [[ ! -d "$ANDROID_HOME" ]]; then
    printf 'error: Android SDK not found at %s\n' "$ANDROID_HOME" >&2
    exit 1
fi

printf '==> Tool policy tests\n'
python3 -m unittest discover -s tools/tests

printf '==> Static rule checks\n'
python3 tools/static_rules.py

printf '==> JVM tests, lint, Android test compilation, and debug APK\n'
printf '    Visual capture matrix: %s (use --visual-captures to include it)\n' "$capture_tests"
# Separate invocations: on a full rebuild, compilation memory held by the Gradle
# JVM plus Robolectric forks plus lint analysis exceeded the 8 GiB build slice.
gradle_common=("${gradle_arguments[@]}" "-Ptvhplayer.captureTests=$capture_tests" --console=plain --no-scan)
./gradlew \
    :client:compileDebugUnitTestSources :decoder-ffmpeg:compileDebugUnitTestSources \
    :app:compilePlayDebugUnitTestSources :app:compilePlayDebugAndroidTestKotlin \
    "${gradle_common[@]}"
./gradlew \
    :client:testDebugUnitTest :decoder-ffmpeg:testDebugUnitTest :app:testPlayDebugUnitTest :appliance:testDebugUnitTest \
    "${gradle_common[@]}"

printf '==> Companion updater loopback E2E\n'
./gradlew :appliance:testDebugUnitTest \
    --tests at.bernhardberger.tvhplayer.appliance.CompanionUpdaterFeedTest \
    -Ptvhplayer.applianceUpdateFeed=http://127.0.0.1:18764/latest \
    "${gradle_common[@]}"
python3 - appliance/build/test-results/testDebugUnitTest/TEST-at.bernhardberger.tvhplayer.appliance.CompanionUpdaterFeedTest.xml <<'COMPANION_UPDATE_RESULTS'
import sys
import xml.etree.ElementTree as ET

results = ET.parse(sys.argv[1]).getroot()
cases = results.findall('testcase')
if not cases or int(results.get('tests', '0')) == 0:
    sys.exit('error: Companion updater loopback tests did not run')
if int(results.get('skipped', '0')) or any(case.find('skipped') is not None for case in cases):
    sys.exit('error: Companion updater loopback tests must not be skipped')
if int(results.get('failures', '0')) or int(results.get('errors', '0')):
    sys.exit('error: Companion updater loopback tests failed')
print('Companion updater loopback tests passed without skips')
COMPANION_UPDATE_RESULTS

# Build the final artifacts without the test-only loopback feed override.
./gradlew \
    :client:lintDebug :brand:lintDebug :decoder-ffmpeg:lintDebug :app:lintPlayDebug :app:assemblePlayDebug \
    "${appliance_tasks[@]}" "${provenance_tasks[@]}" \
    "${gradle_common[@]}"

printf '==> External native dependency and packaged APK integrity\n'
if [[ "$staged_sdk" == true ]]; then
    ./tools/check-native-libs --staged-sdk
else
    ./tools/check-native-libs
fi

apk="app/build/outputs/apk/play/debug/app-play-debug.apk"
appliance_apk="appliance/build/outputs/apk/debug/appliance-debug.apk"
if [[ ! -f "$apk" ]]; then
    printf 'error: expected APK was not produced: %s\n' "$apk" >&2
    exit 1
fi
if [[ ! -f "$appliance_apk" ]]; then
    printf 'error: expected Appliance APK was not produced: %s\n' "$appliance_apk" >&2
    exit 1
fi

aapt=""
zipalign=""
dexdump=""
for candidate in \
    "$ANDROID_HOME/build-tools/36.0.0" \
    "$ANDROID_HOME/build-tools/35.0.0"; do
    if [[ -x "$candidate/aapt" && -x "$candidate/zipalign" ]]; then
        aapt="$candidate/aapt"
        zipalign="$candidate/zipalign"
        break
    fi
done
for candidate in "$ANDROID_HOME/build-tools/36.0.0/dexdump" "$ANDROID_HOME/build-tools/35.0.0/dexdump"; do
    if [[ -x "$candidate" ]]; then
        dexdump="$candidate"
        break
    fi
done
if [[ -z "$dexdump" ]] && command -v dexdump >/dev/null 2>&1; then
    dexdump="$(command -v dexdump)"
fi
if [[ -z "$dexdump" ]]; then
    printf 'error: dexdump is required in Android build-tools or PATH\n' >&2
    exit 1
fi
printf '==> App dex register limit\n'
python3 tools/check_dex_registers.py "$apk" --dexdump "$dexdump"
if [[ -z "$aapt" ]] && command -v aapt >/dev/null 2>&1 && command -v zipalign >/dev/null 2>&1; then
    aapt="$(command -v aapt)"
    zipalign="$(command -v zipalign)"
fi
if [[ -z "$aapt" || -z "$zipalign" ]]; then
    printf 'error: aapt and zipalign are required in Android build-tools or PATH\n' >&2
    exit 1
fi

if ! "$zipalign" -c -P 16 4 "$apk"; then
    printf 'error: APK native libraries are not 16 KB zip-aligned\n' >&2
    exit 1
fi
# Compose brings AndroidX graphics path native libraries even without playback dependencies.
if ! "$zipalign" -c -P 16 4 "$appliance_apk"; then
    printf 'error: Appliance APK native libraries are not 16 KB zip-aligned\n' >&2
    exit 1
fi

badging="$($aapt dump badging "$apk")"
play_manifest="$($aapt dump xmltree "$apk" AndroidManifest.xml)"

if [[ "$play_manifest" != *'android.intent.category.LEANBACK_LAUNCHER'* ||
      "$play_manifest" == *'android.intent.category.HOME'* ||
      "$play_manifest" == *'android.accessibilityservice.AccessibilityService'* ||
      "$play_manifest" == *'ApplianceEntryAccessibilityService'* ]]; then
    printf 'error: Play manifest contract failed\n' >&2
    exit 1
fi

python3 - "$play_manifest" <<'PLAY_ENTRY_CONTRACT'
import re
import sys

tree = sys.argv[1]
permission = 'at.bernhardberger.tvhplayer.debug.permission.APPLIANCE_ENTRY'

def attributes(element):
    # Direct attributes end at the next element (including a nested intent-filter).
    return re.findall(r'(?m)^\s*E: ' + element + r'(?: \(line=\d+\))?\s*\n((?:\s*A:.*\n?)*)', tree)

def has(block, name, value):
    return re.search(r'android:' + name + r'\([^)]*\)=' + re.escape(value) + r'(?:\s|$)', block) is not None

for block in attributes('uses-permission(?:-sdk-23)?'):
    for forbidden in ('android.permission.REQUEST_INSTALL_PACKAGES',
                      'android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION'):
        if has(block, 'name', '"' + forbidden + '"'):
            sys.exit('error: Player must not request package-install permissions')

declared = any(has(block, 'name', '"' + permission + '"') and
               has(block, 'protectionLevel', '(type 0x11)0x2')
               for block in attributes('permission'))
guarded = any(has(block, 'name', '"at.bernhardberger.tvhplayer.ui.ApplianceEntryActivity"') and
              has(block, 'targetActivity', '"at.bernhardberger.tvhplayer.ui.MainActivity"') and
              has(block, 'exported', '(type 0x12)0xffffffff') and
              has(block, 'permission', '"' + permission + '"')
              for block in attributes('activity-alias'))
if not declared or not guarded:
    sys.exit('error: Play signature-guarded appliance entry contract failed')
PLAY_ENTRY_CONTRACT

required_badging=(
    "package: name='at.bernhardberger.tvhplayer.debug'"
    "sdkVersion:'28'"
    "targetSdkVersion:'36'"
    "application-label:'Tvheadend Player Debug'"
    "'armeabi-v7a'"
)
for expected in "${required_badging[@]}"; do
    if [[ "$badging" != *"$expected"* ]]; then
        printf 'error: APK badging is missing %s\n' "$expected" >&2
        exit 1
    fi
done

{
    manifest_tree="$($aapt dump xmltree "$appliance_apk" AndroidManifest.xml)"
    appliance_badging="$($aapt dump badging "$appliance_apk")"
    accessibility_tree="$($aapt dump xmltree "$appliance_apk" res/xml/appliance_entry_accessibility_service.xml)"
    if [[ "$appliance_badging" != *"package: name='at.bernhardberger.tvhplayer.appliance.debug'"* ||
          "$appliance_badging" != *"application-label:'Tvheadend Player Appliance'"* ||
          "$manifest_tree" != *'android.intent.category.LEANBACK_LAUNCHER'* ]]; then
        printf 'error: Appliance manifest contract failed\n' >&2
        exit 1
    fi

    python3 - "$manifest_tree" <<'COMPANION_ENTRY_CONTRACT'
import re
import sys

tree = sys.argv[1]
release = len(sys.argv) > 2 and sys.argv[2] == 'release'
permissions = (
    'at.bernhardberger.tvhplayer' + ('' if release else '.debug') + '.permission.APPLIANCE_ENTRY',
    'android.permission.INTERNET',
    'android.permission.ACCESS_NETWORK_STATE',
    'android.permission.REQUEST_INSTALL_PACKAGES',
    'android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION',
)
blocks = re.findall(r'(?m)^\s*E: uses-permission(?: \(line=\d+\))?\s*\n((?:\s*A:.*\n?)*)', tree)
for permission in permissions:
    if not any(re.search(r'android:name\([^)]*\)="' + re.escape(permission) + r'"(?:\s|$)', block)
               for block in blocks):
        sys.exit('error: Companion is missing required permission ' + permission)

def attributes(element):
    return re.findall(r'(?m)^\s*E: ' + element + r'(?: \(line=\d+\))?\s*\n((?:\s*A:.*\n?)*)', tree)

def has(block, name, value):
    return re.search(r'android:' + name + r'\([^)]*\)=' + re.escape(value) + r'(?:\s|$)', block)

if not any(has(block, 'name', '"at.bernhardberger.tvhplayer.appliance.update.CompanionUpdateJob"') and
           has(block, 'permission', '"android.permission.BIND_JOB_SERVICE"')
           for block in attributes('service')):
    sys.exit('error: Companion update job must require BIND_JOB_SERVICE')
if not any(has(block, 'name', '"at.bernhardberger.tvhplayer.appliance.update.UpdateInstallReceiver"') and
           has(block, 'exported', '(type 0x12)0x0') for block in attributes('receiver')):
    sys.exit('error: Companion install receiver must not be exported')
applications = attributes('application')
if len(applications) != 1:
    sys.exit('error: Companion application declaration missing')
application = applications[0]
if release or not has(application, 'debuggable', '(type 0x12)0xffffffff'):
    if (re.search(r'android:usesCleartextTraffic\(', application) and
            not has(application, 'usesCleartextTraffic', '(type 0x12)0x0')) or \
            re.search(r'android:networkSecurityConfig\(', application):
        sys.exit('error: Release companion must not permit cleartext traffic')
COMPANION_ENTRY_CONTRACT

    required_home_entries=(
        'android.intent.category.HOME'
        'android.intent.category.DEFAULT'
    )
    for expected in "${required_home_entries[@]}"; do
        if [[ "$manifest_tree" != *"$expected"* ]]; then
            printf 'error: APK manifest is missing HOME entry %s\n' "$expected" >&2
            exit 1
        fi
    done

    required_accessibility_entries=(
        'at.bernhardberger.tvhplayer.accessibility.ApplianceEntryAccessibilityService'
        'android.permission.BIND_ACCESSIBILITY_SERVICE'
        'android.accessibilityservice.AccessibilityService'
    )
    for expected in "${required_accessibility_entries[@]}"; do
        if [[ "$manifest_tree" != *"$expected"* ]]; then
            printf 'error: APK manifest is missing accessibility entry %s\n' "$expected" >&2
            exit 1
        fi
    done

    required_accessibility_metadata=(
        'android:accessibilityFlags(0x01010384)=(type 0x11)0x21'
        'android:canRetrieveWindowContent(0x01010385)=(type 0x12)0x0'
        'android:canRequestFilterKeyEvents(0x010103d9)=(type 0x12)0xffffffff'
    )
    for expected in "${required_accessibility_metadata[@]}"; do
        if [[ "$accessibility_tree" != *"$expected"* ]]; then
            printf 'error: accessibility metadata is missing %s\n' "$expected" >&2
            exit 1
        fi
    done
    if [[ "$accessibility_tree" == *'android:accessibilityEventTypes'* ]]; then
        printf 'error: accessibility service must not subscribe to window or content events\n' >&2
        exit 1
    fi
}

printf '==> APK identity\n'
printf '%s\n' "$badging" | while IFS= read -r line; do
    case "$line" in
        package:*|sdkVersion:*|targetSdkVersion:*|application-label:*|native-code:*)
            printf '%s\n' "$line"
            ;;
    esac
done
sha256sum "$apk"

if [[ "$staged_sdk" == true ]]; then
    printf '==> Development checks passed against the staged SDK (NOT release-verified)\n'
elif [[ "$release_checks" == true ]]; then
    printf '==> Verification passed (Play and Appliance)\n'
else
    printf '==> Verification passed (Play and companion; --release also assembles the companion release APK)\n'
fi
