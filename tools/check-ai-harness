        if entry.get("source") != IMPORTED_SKILL_SOURCE:
            errors.append(f"skills-lock.json: unexpected source for {name}")
        if entry.get("ref") != IMPORTED_SKILL_REF:
            errors.append(f"skills-lock.json: unexpected ref for {name}")
        if entry.get("sourceType") != "github":
            errors.append(f"skills-lock.json: unexpected source type for {name}")
        if entry.get("skillPath") != f"skills/{name}/SKILL.md":
            errors.append(f"skills-lock.json: unexpected skill path for {name}")
        computed_hash = str(entry.get("computedHash", ""))
        if not SKILL_HASH.fullmatch(computed_hash):
            errors.append(f"skills-lock.json: invalid computed hash for {name}")
        elif name in imported_skills:
            actual_hash = skill_folder_hash(ROOT / ".agents/skills" / name)
            if computed_hash != actual_hash:
                errors.append(f"skills-lock.json: content hash mismatch for {name}")

    harness_paths = [
        ROOT / "AGENTS.md",
        ROOT / "docs/README.md",
        ROOT / "docs/archive/README.md",
        ROOT / "docs/ai-engineering-harness.md",
        ROOT / "docs/ai-skills-audit-2026-07-28.md",
        ROOT / "docs/test-device-credential-provisioning.md",
        ROOT / "docs/device-targets.md",
        ROOT / ".tvhplayer-device.example.json",
        ROOT / "skills-lock.json",
        *sorted((ROOT / ".agents").rglob("*.md")),
        *sorted((ROOT / ".opencode").rglob("*.md")),
        *sorted(
            path
            for path in (ROOT / "tools").rglob("*")
            if path.is_file() and "__pycache__" not in path.parts
        ),
    ]
    for path in harness_paths:
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8")
        if PRIVATE_KEY.search(text):
            errors.append(f"{path.relative_to(ROOT)}: contains private-key material")
        if PRIVATE_LAN_IP.search(text):
            errors.append(f"{path.relative_to(ROOT)}: contains a private LAN address")

    try:
        device_example = json.loads(
            (ROOT / ".tvhplayer-device.example.json").read_text(encoding="utf-8")
        )
    except (OSError, json.JSONDecodeError) as exc:
        errors.append(f"invalid device example JSON: {exc}")
        device_example = {}
    if device_example.get("active_target") != "g10":
        errors.append("device example active_target must be g10")
    device_targets = device_example.get("targets", {})
    if not isinstance(device_targets, dict):
        errors.append("device example targets must be an object")
        device_targets = {}
    expected_roles = {
        "g10": "test",
        "nvidia-shield": "test",
        "g08": "production",
    }
    if set(device_targets) != set(expected_roles):
        errors.append("device example must contain exactly g10, nvidia-shield, and g08")
    for name, expected_role in expected_roles.items():
        target = device_targets.get(name, {})
        if not isinstance(target, dict):
            errors.append(f"device example target {name} must be an object")
            continue
        if target.get("role") != expected_role:
            errors.append(f"device example target {name} must use role {expected_role}")
        for key in (
            "serial",
            "package",
            "expected_manufacturer",
            "expected_model",
            "expected_device",
            "expected_product",
        ):
            if not target.get(key):
                errors.append(f"device example target {name} must include {key}")
        if expected_role == "test" and target.get("credential_file") != (
            ".tvhplayer-credentials.json"
        ):
            errors.append(
                f"device example test target {name} must name the ignored credential file"
            )
        if expected_role == "production" and "credential_file" in target:
            errors.append(
                f"device example production target {name} must not name a credential file"
            )

    gitignore = (ROOT / ".gitignore").read_text(encoding="utf-8")
    if ".tvhplayer-credentials.json" not in gitignore.splitlines():
        errors.append("default local credential file must be ignored")

    workflow_path = ROOT / ".github/workflows/build.yml"
    if workflow_path.is_file():
        workflow = workflow_path.read_text(encoding="utf-8")
        if "contents: read" not in workflow:
            errors.append("CI workflow must use read-only contents permission")
        if "./tools/verify" not in workflow:
            errors.append("CI workflow must run ./tools/verify")
        for line in workflow.splitlines():
            stripped = line.strip()
            if not stripped.startswith("uses:") or "@" not in stripped:
                continue
            reference = stripped.rsplit("@", 1)[1].split(maxsplit=1)[0]
            if not re.fullmatch(r"[0-9a-f]{40}", reference):
                errors.append(f"CI action is not pinned to a full SHA: {stripped}")

    forbidden_release_paths = (
        ".github/workflows/android-play.yml",
        ".github/workflows/github-release.yml",
        "fastlane/Appfile",
        "fastlane/Fastfile",
    )
    for relative in forbidden_release_paths:
        if (ROOT / relative).exists():
            errors.append(f"stale release automation must remain disabled: {relative}")

    opencode = shutil.which("opencode")
    if opencode:
        environment = os.environ.copy()
        environment["OPENCODE_PURE"] = "1"
        resolved_config, config_error = run_json_command(
            [opencode, "debug", "config", "--pure"], environment
        )
        if config_error:
            errors.append(f"OpenCode rejected the project config: {config_error}")
        else:
            if not isinstance(resolved_config, dict):
                errors.append("OpenCode resolved config must be a JSON object")
            else:
                if resolved_config.get("default_agent") != "build":
                    errors.append("resolved OpenCode default agent must be build")
                if resolved_config.get("subagent_depth") != 2:
                    errors.append("resolved OpenCode subagent depth must be exactly two")
                resolved_task_policy = resolved_config.get("permission", {}).get("task")
                if resolved_task_policy != EXPECTED_TASK_POLICY:
                    errors.append("resolved OpenCode Task policy does not match the allowlist")
                elif list(resolved_task_policy)[0] != "*":
                    errors.append("resolved OpenCode Task wildcard denial must come first")
                resolved_agents = resolved_config.get("agent", {})
                if not isinstance(resolved_agents, dict):
                    errors.append("resolved OpenCode agents must be an object")
                elif resolved_agents.get("build", {}).get("disable") is True:
                    errors.append("resolved OpenCode build agent must remain enabled")
                resolved_commands = resolved_config.get("command", {})
                if not isinstance(resolved_commands, dict):
                    errors.append("resolved OpenCode commands must be an object")
                else:
                    for name in ISOLATED_REVIEW_COMMANDS:
                        command = resolved_commands.get(name, {})
                        if not isinstance(command, dict) or command.get("subtask") is not True:
                            errors.append(f"resolved command {name} must use an isolated subtask")

            resolved_agent_details: dict[str, dict[str, object]] = {}
            for name in REQUIRED_PRIMARY_AGENTS | ALL_CHILD_AGENTS:
                agent, agent_error = run_json_command(
                    [opencode, "debug", "agent", name, "--pure"], environment
                )
                if agent_error:
                    errors.append(f"OpenCode rejected agent {name}: {agent_error}")
                elif not isinstance(agent, dict):
                    errors.append(f"OpenCode agent {name} must resolve to a JSON object")
                else:
                    resolved_agent_details[name] = agent

            for name in REQUIRED_PRIMARY_AGENTS:
                agent = resolved_agent_details.get(name)
                if not agent:
                    continue
                if agent.get("mode") != "primary":
                    errors.append(f"resolved agent {name} must remain primary")
                expected_policy = EXPECTED_PRIMARY_TASK_POLICIES[name]
                for child in ALL_CHILD_AGENTS:
                    expected_action = expected_policy.get(
                        child, expected_policy["*"]
                    )
                    actual_action = effective_permission(agent, "task", child)
                    if actual_action != expected_action:
                        errors.append(
                            f"resolved agent {name} Task action for {child} must be "
                            f"{expected_action}, got {actual_action}"
                        )
                if effective_permission(agent, "task", "unlisted-child") != "deny":
                    errors.append(f"resolved agent {name} must deny unlisted children")

            for name, expected_steps in EXPECTED_AGENT_STEPS.items():
                agent = resolved_agent_details.get(name)
                if not agent:
                    continue
                if agent.get("mode") != "subagent":
                    errors.append(f"resolved agent {name} must use subagent mode")
                configured_agent = configured_agents.get(name, {})
                expected_model = (
                    configured_agent.get("model")
                    if isinstance(configured_agent, dict)
                    else None
                )
                resolved_model = agent.get("model")
                actual_model = (
                    f"{resolved_model.get('providerID')}/{resolved_model.get('modelID')}"
                    if isinstance(resolved_model, dict)
                    else None
                )
                if actual_model != expected_model:
                    errors.append(
                        f"resolved agent {name} model must be {expected_model}, "
                        f"got {actual_model}"
                    )
                expected_variant = EXPECTED_AGENT_VARIANTS[name]
                if agent.get("variant") != expected_variant:
                    errors.append(
                        f"resolved agent {name} variant must be {expected_variant}, "
                        f"got {agent.get('variant')}"
                    )
                if agent.get("steps") != expected_steps:
                    errors.append(
                        f"resolved agent {name} steps must be {expected_steps}, "
                        f"got {agent.get('steps')}"
                    )

            build = resolved_agent_details.get("build")
            if build:
                tools = build.get("tools", {})
                mutation_tools = (
                    [key for key in ("apply_patch", "edit", "write") if key in tools]
                    if isinstance(tools, dict)
                    else []
                )
                if not mutation_tools or not any(
                    tools[key] is not False for key in mutation_tools
                ):
                    errors.append("resolved build primary must remain writable")
                if effective_permission(build, "bash", "git status -sb") != "allow":
                    errors.append("resolved build must allow local Git inspection")
                if effective_permission(
                    build, "bash", "python3 -c 'write source'"
                ) != "allow":
                    errors.append("resolved build must allow routine local Bash commands")
                if effective_permission(build, "bash", "git push origin main") != "allow":
                    errors.append("resolved build must inherit the trusted Bash posture")
                if effective_permission(build, "webfetch", "*") != "allow":
                    errors.append("resolved build must allow web fetches")
                if effective_permission(
                    build, "external_directory", "/root/projects/tvheadend-sdk/**"
                ) != "allow":
                    errors.append("resolved build must allow package-authorized external paths")

            for name in ALL_CHILD_AGENTS:
                agent = resolved_agent_details.get(name)
                if not agent:
                    continue
                for child in ALL_CHILD_AGENTS | {"unlisted-child"}:
                    expected_action = (
                        "allow" if child == "app-locator" else "deny"
                    )
                    actual_action = effective_permission(agent, "task", child)
                    if actual_action != expected_action:
                        errors.append(
                            f"resolved child agent {name} Task action for {child} must be "
                            f"{expected_action}, got {actual_action}"
                        )

            for name in READ_ONLY_CHILD_AGENTS:
                agent = resolved_agent_details.get(name)
                if not agent:
                    continue
                tools = agent.get("tools", {})
                mutation_tools = (
                    [key for key in ("apply_patch", "edit", "write") if key in tools]
                    if isinstance(tools, dict)
                    else []
                )
                if not mutation_tools or any(tools[key] is not False for key in mutation_tools):
                    errors.append(f"resolved child agent {name} must remain read-only")
                if effective_permission(agent, "edit", "*") != "deny":
                    errors.append(f"resolved child agent {name} must deny edits")
                if not isinstance(tools, dict) or tools.get("bash") is not False:
                    errors.append(f"resolved child agent {name} must disable Bash")
                if effective_permission(agent, "bash", "git status -sb") != "deny":
                    errors.append(f"resolved child agent {name} must deny Bash")
                expected_webfetch = EXPECTED_CHILD_WEBFETCH_PERMISSIONS[name]
                if effective_permission(agent, "webfetch", "*") != expected_webfetch:
                    errors.append(
                        f"resolved child agent {name} webfetch must be "
                        f"{expected_webfetch}"
                    )
                expected_webfetch_tool = expected_webfetch == "allow"
                if tools.get("webfetch") is not expected_webfetch_tool:
                    errors.append(
                        f"resolved child agent {name} webfetch tool must be "
                        f"{'enabled' if expected_webfetch == 'allow' else 'disabled'}"
                    )
                if effective_permission(agent, "websearch", "*") != "deny":
                    errors.append(f"resolved child agent {name} must deny websearch")

            tv_ux_reviewer = resolved_agent_details.get("tv-ux-reviewer")
            if tv_ux_reviewer and effective_permission(
                tv_ux_reviewer, "glob", "**/*.{png,jpg,jpeg,webp}"
            ) != "deny":
                errors.append(
                    "resolved tv-ux-reviewer must deny Glob-based evidence discovery"
                )
            discovered, skill_error = run_json_command(
                [opencode, "debug", "skill", "--pure"], environment
            )
            if skill_error:
                errors.append(f"OpenCode rejected project skills: {skill_error}")
            elif not isinstance(discovered, list):
                errors.append("OpenCode skill registry must be a JSON array")
            else:
                discovered_names = {
                    entry.get("name")
                    for entry in discovered
                    if isinstance(entry, dict) and isinstance(entry.get("name"), str)
                }
                missing_runtime_skills = seen_skills - discovered_names
                if missing_runtime_skills:
                    errors.append(
                        "OpenCode did not discover project skills: "
                        f"{sorted(missing_runtime_skills)}"
                    )
    else:
        warnings.append("opencode not found; skipped live parser and skill discovery checks")

    for warning in warnings:
        print(f"warning: {warning}")
    for error in errors:
        print(f"error: {error}", file=sys.stderr)

    if errors:
        return 1
    print(
        "AI harness passed: config, agents, skills, commands, documentation "
        "authority, safety scan, and resolved OpenCode permissions/discovery"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
