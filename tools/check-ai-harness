        if not (ROOT / relative).is_file():
            errors.append(f"missing required file: {relative}")
    for relative in RETIRED_HARNESS_PATHS:
        if (ROOT / relative).exists():
            errors.append(f"retired harness path must remain absent: {relative}")

    try:
        config = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        errors.append(f"invalid OpenCode JSON: {exc}")
        config = {}

    if config.get("$schema") != "https://opencode.ai/config.json":
        errors.append(".opencode/opencode.json must declare the official schema")
    if config.get("default_agent") != "build":
        errors.append("default_agent must be build")
    if config.get("agent", {}).get("build", {}).get("disable") is not False:
        errors.append("built-in build agent must be explicitly enabled")
    if "steps" in config.get("agent", {}).get("build", {}):
        errors.append("built-in build agent must not have a repository step ceiling")
    if config.get("share") != "disabled":
        errors.append("project session sharing must remain disabled")
    if config.get("subagent_depth") != 2:
        errors.append("subagent depth must be exactly two")
    if config.get("instructions") != ["AGENTS.md"]:
        errors.append("project instructions must load only AGENTS.md")
    task_policy = config.get("permission", {}).get("task")
    if task_policy != EXPECTED_TASK_POLICY:
        errors.append("project Task policy must exactly match the bounded child allowlist")
    elif list(task_policy)[0] != "*":
        errors.append("project Task wildcard denial must precede named exceptions")
    configured_agents = config.get("agent", {})
    expected_configured_agents = {"build", *EXPECTED_AGENT_VARIANTS}
    if set(configured_agents) != expected_configured_agents:
        errors.append(
            "configured agents must contain only build and the seven read-only roles"
        )
