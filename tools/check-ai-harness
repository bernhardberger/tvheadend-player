        agent_config = configured_agents.get(name, {})
        model = agent_config.get("model") if isinstance(agent_config, dict) else None
        model_base = model.removesuffix("-fast") if isinstance(model, str) else None
        if model_base != expected_model_base:
            errors.append(
                f"agent {name} model must be {expected_model_base} with an allowed "
                f"service tier, got {model}"
            )
    for name, expected_steps in EXPECTED_AGENT_STEPS.items():
        agent_config = configured_agents.get(name, {})
        actual_steps = agent_config.get("steps") if isinstance(agent_config, dict) else None
        if actual_steps != expected_steps:
            errors.append(
                f"agent {name} steps must be {expected_steps}, got {actual_steps}"
