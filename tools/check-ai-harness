def frontmatter(path: Path) -> dict[str, str]:
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        return {}
    values: dict[str, str] = {}
    for line in text.splitlines()[1:]:
        if line == "---":
            break
        if not line.startswith(" ") and ":" in line:
            key, value = line.split(":", 1)
            values[key.strip()] = value.strip().strip("'\"")
    return values


def frontmatter_permission(path: Path, name: str) -> str | None:
    """Read one scalar permission from an agent's frontmatter."""
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        return None
    in_permission = False
    for line in text.splitlines()[1:]:
        if line == "---":
            break
        if line == "permission:":
            in_permission = True
            continue
        if in_permission and line and not line.startswith(" "):
            break
        if in_permission and line.startswith("  ") and ":" in line:
            key, value = line.strip().split(":", 1)
            if key == name:
                scalar = value.strip().strip("'\"")
                return scalar or None
    return None


def frontmatter_task_policy(path: Path) -> str | dict[str, str] | None:
    """Read the scalar or ordered mapping for permission.task."""
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        return None
    lines = text.splitlines()[1:]
    in_permission = False
    for index, line in enumerate(lines):
        if line == "---":
            break
        if line == "permission:":
            in_permission = True
            continue
        if in_permission and line and not line.startswith(" "):
            break
        if not in_permission or not line.startswith("  task:"):
            continue
        scalar = line.split(":", 1)[1].strip().strip("'\"")
        if scalar:
            return scalar
        policy: dict[str, str] = {}
        for nested in lines[index + 1 :]:
            if nested == "---" or (nested and not nested.startswith("    ")):
                break
            if nested.startswith("    ") and ":" in nested:
                key, value = nested.strip().split(":", 1)
                policy[key.strip("'\"")] = value.strip().strip("'\"")
        return policy
    return None


def skill_folder_hash(path: Path) -> str:
    """Match the Skills CLI hash: sorted relative paths followed by file bytes."""
    digest = hashlib.sha256()
    files = sorted(
        child
        for child in path.rglob("*")
        if child.is_file() and not {".git", "node_modules"} & set(child.parts)
    )
    for child in files:
        digest.update(child.relative_to(path).as_posix().encode("utf-8"))
        digest.update(child.read_bytes())
    return digest.hexdigest()


def run_json_command(
    command: list[str], environment: dict[str, str]
) -> tuple[object | None, str | None]:
    """Run OpenCode with a real output file and decode its JSON response."""
    with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as output:
        result = subprocess.run(
            command,
            cwd=ROOT,
            env=environment,
            text=True,
            stdout=output,
            stderr=subprocess.PIPE,
            timeout=30,
            check=False,
        )
        output.seek(0)
        raw_output = output.read()
    if result.returncode != 0:
        detail = result.stderr.strip().splitlines()
        return None, detail[-1] if detail else f"exit code {result.returncode}"
    try:
        return json.loads(raw_output), None
    except json.JSONDecodeError as exc:
        return None, f"invalid JSON: {exc}"


def effective_permission(agent: dict[str, object], permission: str, pattern: str) -> str | None:
    """Resolve the last matching permission rule emitted by OpenCode."""
    action = None
    rules = agent.get("permission", [])
    if not isinstance(rules, list):
        return None
    for rule in rules:
        if not isinstance(rule, dict) or rule.get("permission") != permission:
            continue
        rule_pattern = rule.get("pattern")
        rule_action = rule.get("action")
        if (
            isinstance(rule_pattern, str)
            and isinstance(rule_action, str)
            and fnmatch.fnmatchcase(pattern, rule_pattern)
        ):
            action = rule_action
    return action


def main() -> int:
