    for relative in forbidden_release_paths:
        if (ROOT / relative).exists():
            errors.append(f"stale release automation must remain disabled: {relative}")

    opencode = shutil.which("opencode")
    if opencode:
        environment = os.environ.copy()
        environment["OPENCODE_PURE"] = "1"
        resolved_config, config_error = run_json_command(
            [opencode, "debug", "config", "--pure"], environment
        )
        if config_error:
            errors.append(f"OpenCode rejected the project config: {config_error}")
        else:
            if not isinstance(resolved_config, dict):
                errors.append("OpenCode resolved config must be a JSON object")
            else:
                if resolved_config.get("default_agent") != "android-tv":
                    errors.append("resolved OpenCode default agent must be android-tv")
                if resolved_config.get("subagent_depth") != 1:
                    errors.append("resolved OpenCode subagent depth must be exactly one")
                resolved_task_policy = resolved_config.get("permission", {}).get("task")
                if resolved_task_policy != EXPECTED_TASK_POLICY:
                    errors.append("resolved OpenCode Task policy does not match the allowlist")
                elif list(resolved_task_policy)[0] != "*":
                    errors.append("resolved OpenCode Task wildcard denial must come first")
                resolved_agents = resolved_config.get("agent", {})
                if not isinstance(resolved_agents, dict):
                    errors.append("resolved OpenCode agents must be an object")
                elif resolved_agents.get("build", {}).get("disable") is not True:
                    errors.append("resolved OpenCode build agent must remain disabled")
                resolved_commands = resolved_config.get("command", {})
                if not isinstance(resolved_commands, dict):
                    errors.append("resolved OpenCode commands must be an object")
                else:
                    for name in ISOLATED_REVIEW_COMMANDS:
                        command = resolved_commands.get(name, {})
                        if not isinstance(command, dict) or command.get("subtask") is not True:
                            errors.append(f"resolved command {name} must use an isolated subtask")

            resolved_agent_details: dict[str, dict[str, object]] = {}
            for name in REQUIRED_PRIMARY_AGENTS | ALL_CHILD_AGENTS:
                agent, agent_error = run_json_command(
                    [opencode, "debug", "agent", name, "--pure"], environment
                )
                if agent_error:
                    errors.append(f"OpenCode rejected agent {name}: {agent_error}")
                elif not isinstance(agent, dict):
                    errors.append(f"OpenCode agent {name} must resolve to a JSON object")
                else:
                    resolved_agent_details[name] = agent

            for name in REQUIRED_PRIMARY_AGENTS:
                agent = resolved_agent_details.get(name)
                if not agent:
                    continue
                if agent.get("mode") != "primary":
                    errors.append(f"resolved agent {name} must remain primary")
                for child, expected_action in EXPECTED_TASK_POLICY.items():
                    if child == "*":
                        continue
                    actual_action = effective_permission(agent, "task", child)
                    if actual_action != expected_action:
                        errors.append(
                            f"resolved agent {name} Task action for {child} must be "
                            f"{expected_action}, got {actual_action}"
                        )
                if effective_permission(agent, "task", "unlisted-child") != "deny":
                    errors.append(f"resolved agent {name} must deny unlisted children")

            for name in ALL_CHILD_AGENTS:
                agent = resolved_agent_details.get(name)
                if not agent:
                    continue
                for child in ALL_CHILD_AGENTS | {"unlisted-child"}:
                    if effective_permission(agent, "task", child) != "deny":
                        errors.append(f"resolved child agent {name} must prohibit recursion")

            for name in READ_ONLY_CHILD_AGENTS:
                agent = resolved_agent_details.get(name)
                if not agent:
                    continue
                tools = agent.get("tools", {})
                mutation_tools = (
                    [key for key in ("apply_patch", "edit", "write") if key in tools]
                    if isinstance(tools, dict)
                    else []
                )
                if not mutation_tools or any(tools[key] is not False for key in mutation_tools):
                    errors.append(f"resolved child agent {name} must remain read-only")

            explore = resolved_agent_details.get("explore")
            if explore:
                tools = explore.get("tools", {})
                if not isinstance(tools, dict) or any(
                    tools.get(name) is not False for name in ("bash", "webfetch")
                ):
                    errors.append("resolved explore agent must remain repository-only")

            tv_ux_reviewer = resolved_agent_details.get("tv-ux-reviewer")
            if tv_ux_reviewer and effective_permission(
                tv_ux_reviewer, "glob", "**/*.{png,jpg,jpeg,webp}"
            ) != "deny":
                errors.append(
                    "resolved tv-ux-reviewer must deny Glob-based evidence discovery"
                )
            if tv_ux_reviewer:
                tools = tv_ux_reviewer.get("tools", {})
                if not isinstance(tools, dict) or tools.get("bash") is not False:
                    errors.append(
                        "resolved tv-ux-reviewer must deny Bash-based evidence discovery"
                    )

            discovered, skill_error = run_json_command(
                [opencode, "debug", "skill", "--pure"], environment
            )
            if skill_error:
                errors.append(f"OpenCode rejected project skills: {skill_error}")
            elif not isinstance(discovered, list):
                errors.append("OpenCode skill registry must be a JSON array")
            else:
                discovered_names = {
                    entry.get("name")
                    for entry in discovered
                    if isinstance(entry, dict) and isinstance(entry.get("name"), str)
                }
                missing_runtime_skills = seen_skills - discovered_names
                if missing_runtime_skills:
                    errors.append(
                        "OpenCode did not discover project skills: "
                        f"{sorted(missing_runtime_skills)}"
                    )
    else:
        warnings.append("opencode not found; skipped live parser and skill discovery checks")

    for warning in warnings:
        print(f"warning: {warning}")
    for error in errors:
        print(f"error: {error}", file=sys.stderr)

    if errors:
        return 1
    print(
        "AI harness passed: config, agents, skills, commands, documentation "
        "authority, safety scan, and resolved OpenCode permissions/discovery"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
