        errors.append(".opencode/commands/tv-ux-review.md: must use tv-ux-reviewer")

    seen_skills: set[str] = set()
    imported_skills: set[str] = set()
    skill_roots = (ROOT / ".opencode/skills", ROOT / ".agents/skills")
    for skill_root in skill_roots:
        for path in sorted(skill_root.glob("*/SKILL.md")):
            metadata = frontmatter(path)
            name = metadata.get("name", "")
            relative = path.relative_to(ROOT)
            if name != path.parent.name:
                errors.append(f"{relative}: skill name must match its directory")
            if not SKILL_NAME.fullmatch(name):
                errors.append(f"{relative}: invalid skill name {name!r}")
            if not metadata.get("description"):
                errors.append(f"{relative}: missing description")
            if name in seen_skills:
                errors.append(f"duplicate skill name: {name}")
            seen_skills.add(name)
            if skill_root.name == "skills" and skill_root.parent.name == ".agents":
                imported_skills.add(name)

    missing_imported = REQUIRED_IMPORTED_SKILLS - imported_skills
    unexpected_imported = imported_skills - REQUIRED_IMPORTED_SKILLS
    if missing_imported:
        errors.append(f"missing reviewed imported skills: {sorted(missing_imported)}")
    if unexpected_imported:
        errors.append(f"unreviewed imported skills present: {sorted(unexpected_imported)}")
    excluded_present = EXCLUDED_IMPORTED_SKILLS & seen_skills
    if excluded_present:
        errors.append(f"excluded imported skills present: {sorted(excluded_present)}")

    try:
        skills_lock = json.loads(SKILLS_LOCK_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        errors.append(f"invalid skills lock JSON: {exc}")
        skills_lock = {}
    if skills_lock.get("version") != 1:
        errors.append("skills-lock.json must use schema version 1")
    locked_skills = skills_lock.get("skills", {})
    if not isinstance(locked_skills, dict):
        errors.append("skills-lock.json skills must be an object")
        locked_skills = {}
    if set(locked_skills) != imported_skills:
        errors.append("skills-lock.json entries must exactly match imported skills")
    for name, entry in locked_skills.items():
        if not isinstance(entry, dict):
            errors.append(f"skills-lock.json: invalid entry for {name}")
