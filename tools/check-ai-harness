        try:
            model_tier_result = subprocess.run(
                [str(model_tier_tool), "status"],
                cwd=ROOT,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=10,
                check=False,
            )
