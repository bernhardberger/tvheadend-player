{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "disabled",
  "subagent_depth": 2,
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "build": {
      "disable": false,
      "model": "openai/gpt-6-astra",
      "variant": "medium"
    },
    "app-locator": {
      "model": "openai/gpt-6-luna",
      "variant": "low",
      "steps": 20
    },
    "app-explore": {
      "model": "openai/gpt-6-sol",
      "variant": "medium",
      "steps": 30
    },
    "app-planner": {
      "model": "openai/gpt-6-astra",
      "variant": "xhigh",
      "steps": 45
    },
    "app-analyze": {
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "steps": 30
    },
    "app-research": {
      "model": "openai/gpt-6-astra",
      "variant": "medium",
      "steps": 35
    },
    "android-reviewer": {
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "steps": 45
    },
    "tv-evidence-curator": {
      "model": "openai/gpt-6-sol",
      "variant": "medium",
      "steps": 25
    },
    "tv-ux-brief": {
      "model": "anthropic/claude-opus-5-5",
      "variant": "high",
      "steps": 35
    },
    "tv-ux-reviewer": {
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "steps": 40
    }
  },
  "permission": {
    "edit": "allow",
    "shell": "allow",
    "webfetch": "allow",
    "external_directory": "allow"
  }
}
