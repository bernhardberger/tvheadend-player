{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "android-tv",
  "share": "disabled",
  "subagent_depth": 1,
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "build": {
      "disable": true
    },
    "android-tv": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "steps": 128
    },
    "scout": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "steps": 48
    },
    "android-reviewer": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "steps": 64
    },
    "tv-ux-reviewer": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "steps": 40
    }
  },
  "permission": {
    "task": {
      "*": "deny",
      "scout": "allow",
      "android-reviewer": "allow",
      "tv-ux-reviewer": "allow"
    }
  }
}
