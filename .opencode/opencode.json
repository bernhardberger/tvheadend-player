{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "disabled",
  "subagent_depth": 1,
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "build": {
      "disable": false
    },
    "app-locator": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "steps": 20
    },
    "app-planner": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "steps": 45
    },
    "app-analyze": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "steps": 30
    },
    "app-research": {
      "model": "openai/gpt-5.6-sol",
      "variant": "low",
      "steps": 35
    },
    "android-reviewer": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "steps": 45
    },
    "tv-ux-reviewer": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "steps": 40
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "./gradlew *": "allow",
      "./tools/verify*": "allow",
      "./tools/check-ai-harness*": "allow",
      "./tools/check-native-libs*": "allow",
      "./tools/device doctor*": "allow",
      "./tools/device current*": "allow",
      "./tools/device package-info*": "allow",
      "git push*": "deny",
      "git tag*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout --*": "deny",
      "git rebase*": "deny",
      "gh release*": "deny",
      "gh pr*": "deny",
      "./tools/release*": "deny"
    },
    "task": {
      "*": "deny",
      "app-locator": "allow",
      "app-planner": "allow",
      "app-analyze": "allow",
      "app-research": "allow",
      "android-reviewer": "allow",
      "tv-ux-reviewer": "allow"
    }
  }
}
