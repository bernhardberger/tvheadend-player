{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "android-tv",
  "share": "disabled",
  "subagent_depth": 1,
  "instructions": ["AGENTS.md"],
  "agent": {
    "build": {
      "disable": true
    },
    "explore": {
      "model": "openai/gpt-5.6-terra-fast",
      "variant": "medium",
      "permission": {
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny"
      }
    },
    "general": {
      "model": "openai/gpt-5.6-sol-fast",
      "variant": "medium",
      "permission": {
        "task": "deny"
      }
    },
    "quick-explore": {
      "model": "openai/gpt-5.6-luna-fast",
      "variant": "low"
    },
    "scout": {
      "model": "openai/gpt-5.6-terra-fast",
      "variant": "medium"
    },
    "android-reviewer": {
      "model": "openai/gpt-5.6-sol-fast",
      "variant": "high"
    },
    "tv-interaction-reviewer": {
      "model": "openai/gpt-5.6-sol-fast",
      "variant": "high"
    },
    "tv-ux-reviewer": {
      "model": "openai/gpt-5.6-sol-fast",
      "variant": "high"
    }
  },
  "permission": {
    "task": {
      "*": "deny",
      "quick-explore": "allow",
      "explore": "allow",
      "scout": "allow",
      "android-reviewer": "allow",
      "tv-interaction-reviewer": "allow",
      "tv-ux-reviewer": "allow",
      "general": "ask"
    }
  }
}
