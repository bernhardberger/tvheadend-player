{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "disabled",
  "subagent_depth": 2,
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "build": {
      "disable": false
    },
    "app-locator": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "steps": 20
    },
    "app-explore": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "steps": 30
    },
    "app-planner": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "steps": 45
    },
    "app-analyze": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "steps": 30
    },
    "app-research": {
      "model": "openai/gpt-5.6-sol",
      "variant": "low",
      "steps": 35
    },
    "android-reviewer": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "steps": 45
    },
    "app-review-muse": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "variant": "xhigh",
      "steps": 45
    },
    "tv-evidence-curator": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "steps": 25
    },
    "tv-ux-brief": {
      "model": "anthropic/claude-opus-5",
      "variant": "high",
      "steps": 35
    },
    "tv-ux-reviewer": {
      "model": "anthropic/claude-opus-5",
      "variant": "medium",
      "steps": 40
    },
    "claude-audit-lead": {
      "model": "anthropic/claude-opus-5",
      "variant": "high",
      "steps": 45
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "task": {
      "*": "deny",
      "app-locator": "allow",
      "app-explore": "allow",
      "app-planner": "allow",
      "app-analyze": "allow",
      "app-research": "allow",
      "android-reviewer": "allow",
      "app-review-muse": "allow",
      "tv-evidence-curator": "allow",
      "tv-ux-brief": "allow",
      "tv-ux-reviewer": "allow",
      "claude-audit-lead": "allow"
    }
  }
}
